+// P4.36 probe: GGML_DUP_PROBE=0 / loom_dup_probe_set(0) sends a transpose back to ggml's generic path.
+static int loom_dup_probe_value = -1;
+extern "C" void loom_dup_probe_set(int v) { loom_dup_probe_value = v; }
+static int loom_dup_probe() {
+    if (loom_dup_probe_value < 0) {
+        const char * e = getenv("GGML_DUP_PROBE");
+        loom_dup_probe_value = e ? atoi(e) : 1;
+    }
+    return loom_dup_probe_value;
+}
