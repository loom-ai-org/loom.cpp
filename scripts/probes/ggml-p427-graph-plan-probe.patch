+// ================= P4.27 MEASUREMENT PROBE -- NOT CARRIED, NOT FOR UPSTREAM =================
+// `LOOM_UNARY_SERIAL=1` puts every row of an `apply_unary_op` on thread 0, which is what P4.25
+// believed ggml was already doing (`ggml_get_n_tasks` gives TANH/SIGMOID/EXP `n_tasks = 1`). It is
+// not: `n_tasks` is a graph-level clamp in this version and these ops split over rows like any other.
+// Flipping this on is therefore the measurement P4.25 never made -- what threading the transcendental
+// unaries is worth in a REAL model, measured by taking it away rather than by adding it.
+// See loom.cpp Epic-05 P4.27.
+static bool loom_unary_serial() {
+    static int v = -1;
+    if (v < 0) {
+        const char * s = getenv("LOOM_UNARY_SERIAL");
+        v = (s && atoi(s)) ? 1 : 0;
+    }
+    return v == 1;
+}
