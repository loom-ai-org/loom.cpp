+    // ================= P4.27 MEASUREMENT PROBE -- NOT CARRIED, NOT FOR UPSTREAM =================
+    // `ggml_get_n_tasks` is read nowhere else: there is no per-node thread count in this version of
+    // ggml. Every thread runs every node with `params.nth = cplan.n_threads`, and an op that must not
+    // split says so itself by returning early when `ith != 0`. So the line above is a GRAPH-level
+    // clamp -- it can only take the whole graph down to one thread, when NO node in it declares more.
+    // A `TANH` sitting in a graph that also holds a `MUL_MAT` has been threaded all along.
+    //
+    //   LOOM_PLAN_PROBE=1   print only the graphs that are clamped
+    //   LOOM_PLAN_PROBE=2   print every plan, so "not clamped" is a positive observation
+    //
+    // See loom.cpp Epic-05 P4.27 and scripts/bench20.cpp.
+    {
+        static int probe = -1;
+        if (probe < 0) {
+            const char * s = getenv("LOOM_PLAN_PROBE");
+            probe = s ? atoi(s) : 0;
+        }
+        if (probe >= 2 || (probe == 1 && cplan.n_threads < n_threads)) {
+            fprintf(stderr, "[plan] %s: %d nodes, asked %d threads, planned %d",
+                    cplan.n_threads < n_threads ? "CLAMPED" : "ok",
+                    cgraph->n_nodes, n_threads, cplan.n_threads);
+            if (cgraph->n_nodes > 0) {
