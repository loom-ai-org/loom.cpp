     const char * knl_base = (const char *)kernel->data;
     const ggml_type knl_type = kernel->type;
 
+    // [x_lo, x_hi): outputs whose every horizontal tap is in bounds. Independent of the row and channel.
+    const int64_t span = (p.knl_w - 1) * p.dilation_x;
+    int64_t x_lo = (p.pad_x + p.stride_x - 1) / p.stride_x;
+    const int64_t last_num = p.src_w - 1 - span + p.pad_x;
+    int64_t x_hi = last_num >= 0 ? last_num / p.stride_x + 1 : 0;
