+
+// ARMv6 ONLY: F32 MUL_MAT WITH n >= 24 ON THE SAME SHORT-VECTOR KERNEL (loom ADR-079, item P4.32d).
+//
+// The k = 1 conv kernel above is already a GEMM tile: per input row, a vector of four positions times
+// four scalars. Here the "window" is a transposed block of the weights, [K chunk][32 rows of A], so a
+// vector is A[m..m+3][k], and the scalars are four columns of B, packed [N/4][K][4] once per call. Each
+// accumulator vector is then C[n][m..m+3], contiguous in ggml's dst, written in place; K is chunked so
+// the window stays in L1, each later chunk continuing from the partial sums in C. A partial last quad of
+// columns goes through a small scratch. M must be a multiple of 4 (else tinyBLAS keeps it).
+// GGML_CPU_ARMV6_GEMM=0 turns it off.
+// Swept on the board (loom scripts/bench51.cpp gemm, TB 32), against tinyBLAS_F32_ARMV6: n = 16 0.47 vs
+// 0.49 GOP/s, n = 24 0.56 vs 0.49, n = 32 0.61 vs 0.50, Moonshine's n = 457 0.76-0.79 vs 0.29-0.38.
+#define GGML_ARMV6_GEMM_MIN_N 24
+
+struct ggml_armv6_mm_geom { int64_t TB, TBx, xrow, icc, nch, Nq; size_t n_bp, n_x, n_s; };
+
+static bool ggml_armv6_mm_ok(const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst) {
+    static const int enabled = ggml_armv6_conv_env("GGML_CPU_ARMV6_GEMM", 1);
+    if (!enabled) return false;
+    if (src0->type != GGML_TYPE_F32 || src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) return false;
+    if (src1->ne[1] < GGML_ARMV6_GEMM_MIN_N || src0->ne[1] % 4 != 0) return false;
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1) return false;
+    if (src0->nb[0] != sizeof(float) || src1->nb[0] != sizeof(float) || dst->nb[0] != sizeof(float)) return false;
+    return true;
+}
+
+static ggml_armv6_mm_geom ggml_armv6_mm_plan(int64_t K, int64_t N) {
+    static const int tb_env = ggml_armv6_conv_env("GGML_CPU_ARMV6_GEMM_TB", 0);
+    static const int l1_env = ggml_armv6_conv_env("GGML_CPU_ARMV6_CONV_L1", 12 * 1024);
+    ggml_armv6_mm_geom g;
+    // TB 32 / 64 / 128 over Moonshine's prefill and the conformer's FFN: 0.76-0.79 / 0.74-0.78 / 0.63-0.66.
+    g.TB   = tb_env > 0 ? (tb_env + 3) & ~3 : 32;
+    g.TBx  = g.TB + 4;
+    g.xrow = g.TBx;
+    const int64_t icc_max = MAX((int64_t) 1, (int64_t) l1_env / (g.xrow * 4 + 16) - 1);
+    g.nch  = (K + icc_max - 1) / icc_max;
+    g.icc  = (K + g.nch - 1) / g.nch;
+    g.Nq   = (N + 3) / 4;
+    g.n_bp = (size_t) g.Nq * K * 4 + 4;            // + the kernel's W preload past the last quad
+    g.n_x  = (size_t) (g.icc + 1) * g.xrow + 4;    // + the spare row the last preload reads
+    g.n_s  = (size_t) 4 * g.TBx + 4;               // the partial quad's rows + four zeros (the "bias")
+    return g;
+}
+
+size_t ggml_armv6_mul_mat_f32_wsize(const struct ggml_tensor * node, int n_tasks) {
+    if (!ggml_armv6_mm_ok(node->src[0], node->src[1], node)) return 0;
+    const ggml_armv6_mm_geom g = ggml_armv6_mm_plan(node->src[0]->ne[0], node->src[1]->ne[1]);
+    return GGML_PAD(g.n_bp * 4, 64) + (size_t) n_tasks * GGML_PAD((g.n_x + g.n_s) * 4, 64);
+}
+
+bool ggml_armv6_mul_mat_f32(const struct ggml_compute_params * params, const struct ggml_tensor * src0,
+                            const struct ggml_tensor * src1, struct ggml_tensor * dst) {
+    // Graph MUL_MAT nodes only. ggml_call_mul_mat* (the convolutions' im2col fallback) builds a dst on the
+    // stack (op NONE) and calls mul_mat with its own patches in params->wdata, which the packing below
+    // would overwrite -- the conv sweep test caught exactly that. Those keep tinyBLAS; ggml_graph_plan
+    // sized the work buffer for this only on real nodes anyway.
+    if (dst->op != GGML_OP_MUL_MAT) return false;
+    if (params->use_ref || !ggml_armv6_mm_ok(src0, src1, dst)) return false;
+    const int64_t K = src0->ne[0], M = src0->ne[1], N = src1->ne[1];
+    const ggml_armv6_mm_geom g = ggml_armv6_mm_plan(K, N);
+    const size_t per_thread = GGML_PAD((g.n_x + g.n_s) * 4, 64);
+    if (GGML_PAD(g.n_bp * 4, 64) + (size_t) params->nth * per_thread > params->wsize) return false;
+
+    const char *  A   = (const char *) src0->data;
+    const size_t  lda = src0->nb[1];
+    const char *  B   = (const char *) src1->data;
+    const size_t  ldb = src1->nb[1];
+    float *       C   = (float *) dst->data;
+    const int64_t ldc = dst->nb[1] / sizeof(float);
+
+    float * bp = (float *) params->wdata;
+    float * xw = (float *) ((char *) params->wdata + GGML_PAD(g.n_bp * 4, 64) + (size_t) params->ith * per_thread);
+    float * sc = xw + g.n_x;                         // [4][TBx] scratch, then four zeros
+    float * zeros = sc + 4 * g.TBx;
+    for (int i = 0; i < 4; ++i) zeros[i] = 0.0f;
+
+    for (int64_t q = params->ith; q < g.Nq; q += params->nth) {
+        float * d = bp + (size_t) q * K * 4;
+        for (int64_t k = 0; k < K; ++k)
+            for (int64_t r = 0; r < 4; ++r) {
+                const int64_t n = 4 * q + r;
+                *d++ = n < N ? ((const float *) (B + n * ldb))[k] : 0.0f;
+            }
+    }
+    if (params->ith == 0) for (int i = 0; i < 4; ++i) bp[g.n_bp - 4 + i] = 0.0f;
+    ggml_barrier(params->threadpool);
+
+    const int64_t nblk = (M + g.TB - 1) / g.TB;
+    const int64_t per  = (nblk + params->nth - 1) / params->nth;
+    const int64_t b0   = params->ith * per, b1 = MIN(b0 + per, nblk);
+    const int64_t full = N / 4;                      // quads whose four rows all exist in C
+
+    ggml_armv6_conv_args a;
+    a.xrow = (int32_t) (g.xrow * 4);
+    a.d4   = 4;                                      // one tap: the dilation is never used
+    const ggml_armv6_conv_fn fn = ggml_armv6_conv_f32[1];
+    for (int64_t b = b0; b < b1; ++b) {
+        const int64_t m0 = b * g.TB, mb = MIN(g.TB, M - m0);
+        for (int64_t ch = 0; ch < g.nch; ++ch) {
+            const int64_t k0 = ch * g.icc, kc = MIN(g.icc, K - k0);
+            for (int64_t i = 0; i < mb; ++i) {       // window[kk][i] = A[m0 + i][k0 + kk]
+                const float * src = (const float *) (A + (m0 + i) * lda) + k0;
+                float *       dw  = xw + i;
+                for (int64_t kk = 0; kk < kc; ++kk) dw[kk * g.xrow] = src[kk];
+            }
+            a.n_ic = (int32_t) kc;
+            a.x    = xw;
+            a.nt   = (int32_t) (mb / 4);
+            for (int64_t q = 0; q < g.Nq; ++q) {
+                a.w = bp + ((size_t) q * K + k0) * 4;
+                a.b = ch == 0 ? zeros : nullptr;
+                if (q < full) { a.y = C + 4 * q * ldc + m0; a.ystride = (int32_t) (ldc * 4); }
+                else          { a.y = sc;                   a.ystride = (int32_t) (g.TBx * 4); }
+                fn(&a);
+            }
+        }
+        for (int64_t n = 4 * full; n < N; ++n)           // the partial quad's real rows
+            memcpy(C + n * ldc + m0, sc + (n - 4 * full) * g.TBx, (size_t) mb * sizeof(float));
+    }
+    return true;
+}
 #endif
 
