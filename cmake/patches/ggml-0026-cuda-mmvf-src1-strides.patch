+// mul_mat_vec_f reads src1 as float2, so every src1 stride it steps by must be a whole number of float2:
+// the column stride when there is more than one column, the channel and sample strides when there is more
+// than one of those. ggml_cuda_should_use_mmvf only looks at src0. A stride that is never stepped by does
+// not matter -- a squeeze-excite's pooled [1, C] permuted to one [C, 1] column has nb[1] == 4, and used to
+// abort in launch_mul_mat_vec_f_cuda's `stride_col_y % 2` assert for nothing.
+static bool ggml_cuda_mmvf_src1_strides_ok(const ggml_tensor * src1) {
+    const size_t ts = ggml_type_size(src1->type);
+    for (int i = 1; i < GGML_MAX_DIMS; ++i) {
+        if (src1->ne[i] > 1 && (src1->nb[i]/ts) % 2 != 0) {
+            return false;
+        }
+    }
+    return true;
+}
