+float quantize_column_pairs(const float * x, int64_t K, uint32_t * xp) {
+    float m = 0.0f, poison = 0.0f;
+    for (int64_t k = 0; k < K; ++k) {
+        const float a = fabsf(x[k]);
+        m = a > m ? a : m;
+        poison += x[k] * 0.0f;
+    }
+    const int R = x_range(K);
+    const float inv = m > 0.0f ? R / m : 0.0f;
+    for (int64_t k = 0; k < K; k += 2) {
+        const int32_t q0 = round_s32(x[k] * inv), q1 = round_s32(x[k + 1] * inv);
