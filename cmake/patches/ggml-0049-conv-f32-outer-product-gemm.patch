+#if defined(GGML_USE_LLAMAFILE) && defined(__aarch64__)
+// loom P4.39: the convolutions' GEMMs on P4.38's outer-product path (sgemm.cpp, llamafile_sgemm_f32_packed).
+// That path packs a block of A into its work buffer, and a convolution's work buffer already holds its
+// im2col patches -- which is why it is not reached through ggml_call_mul_mat*. So the block is carved off
+// the END of the convolution's buffer, before the patches are sized, and handed over as a buffer of its own.
+//
+// Pi 4, four threads, this switch off -> on, paired launches: VITS (piper miro) F32 1.068x (1.097 -> 1.025 s),
+// Q8_0_PC 1.054x; Citrinet-256-ls 1.062x / 1.060x; Moonshine tiny 1.034x. What takes it in VITS is the batched
+// im2col below -- the text encoder's and the flow's convolutions (192-768 channels, 100-286 positions,
+// weights over the direct path's budget) -- and the narrowest upsampler. The patch budget was re-swept with
+// the path on (256 KB ties the 512 KB default; 1 MB, 2 MB and no cap lose 5-45%), so it stays.
+//
+// NOT the vocoder's resblocks, which the direct kernel (ggml_conv_1d_direct_ok) keeps: forcing them through
+// im2col and this GEMM (GGML_CPU_CONV1D_BUDGET=0, the n >= 128 floor lowered to their 32-64 channels) made
+// the synthesis 1.178 s against 1.022 with the direct kernel. The gather is a second copy of the input per
+// tap, and with 32-64 output channels the per-call pack of the patches is barely amortised.
+//
+// GGML_CPU_NEON_F32_4X8_CONV=0 switches this off alone (GGML_CPU_NEON_F32_4X8=0 switches off both).
+static bool ggml_conv_f32_op_enabled(void) {
+    static int on = -1;
+    if (on < 0) {
+        const char * e = getenv("GGML_CPU_NEON_F32_4X8_CONV");
+        on = (e && e[0] == '0') ? 0 : 1;
+    }
+    return on == 1;
+}
+
+// Bytes to hold back at the end of a work buffer of `wsize` for the block, or 0 where the path cannot run.
+static size_t ggml_conv_f32_op_carve(ggml_type type, size_t wsize, size_t keep) {
+    if (type != GGML_TYPE_F32 || !ggml_conv_f32_op_enabled()) return 0;
+    const size_t blk = llamafile_sgemm_f32_wsize();
+    return blk > 0 && wsize >= blk + keep ? blk : 0;
+}
+
+// C[j*ldc + i] = sum_l A[i*k + l] * B[j*k + l]; false, having done nothing, where the path declines.
+static bool ggml_conv_f32_op_gemm(const ggml_compute_params * params, size_t carve, int64_t m, int64_t n,
+                                  int64_t k, const void * a, const void * b, float * c, int64_t ldc) {
+    if (carve == 0) return false;
+    ggml_compute_params p = *params;
+    p.wdata = (char *) params->wdata + params->wsize - carve;
+    p.wsize = carve;
+    return llamafile_sgemm_f32_packed(&p, m, n, k, (const float *) a, k, (const float *) b, k, c, ldc);
+}
+#else
+static size_t ggml_conv_f32_op_carve(ggml_type, size_t, size_t) { return 0; }
+static bool ggml_conv_f32_op_gemm(const ggml_compute_params *, size_t, int64_t, int64_t, int64_t,
+                                  const void *, const void *, float *, int64_t) { return false; }
+#endif
