+                                     void * tmp, int64_t patches_per_batch, int64_t patch_n,
+                                     int64_t c_out, int64_t knl_n, float * out, int64_t ldc) {
+#if defined(GGML_USE_LLAMAFILE) && defined(__ARM_FEATURE_SIMD32) && !defined(__ARM_NEON) && !defined(__aarch64__)
+    const int64_t blck = ggml_blck_size(GGML_TYPE_Q8_0);   // == ggml_blck_size(Q4_0) == 32
+    if (qk == NULL || (knl_n % blck) != 0) {
+        return false;
+    }
+    // A KILL SWITCH RATHER THAN AN OPT-IN, now that the `k`-in-blocks bug below is fixed. It was
+    // opt-in for one round because with that bug conformer-ctc transcribed "i", and the first
+    // attempt to attribute that was itself wrong -- the ABBA script reinstalls the baseline wheel in
+    // its last arm, so the "disabled" run that looked like a clean bisect was measuring the baseline.
+    // Same wheel, same session, one environment variable is what finally isolated it.
+    static int disabled = -1;
+    if (disabled < 0) {
+        const char * e = getenv("GGML_CPU_DISABLE_ARMV6_CONV_QGEMM");
+        disabled = (e && e[0] && e[0] != '0') ? 1 : 0;
+    }
+    if (disabled) {
+        return false;
+    }
+
+    // Staged where the F32 path would have put `gemm_output`, which this branch does not use because
+    // it writes straight into dst. Checked against the buffer's real end rather than assumed: a
+    // convolution with a long contraction and few output channels would not fit, and must fall back.
+    const size_t q8row = ggml_row_size(GGML_TYPE_Q8_0, knl_n);
+    char * const   qb  = (char *) tmp + (size_t) patches_per_batch * knl_n * sizeof(float);
+    const char * const wend = (const char *) params->wdata + params->wsize;
+    if (qb + (size_t) patch_n * q8row > wend) {
+        return false;
+    }
