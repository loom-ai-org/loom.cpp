+    // c_out rows of kernel against patch_n columns of patches, written channel-major -- which is why
+    // this is not `llamafile_sgemm`, whose store is the other way round.
+    // `k` IS IN BLOCKS, NOT ELEMENTS -- `llamafile_sgemm`'s own callers pass
+    // `ne00 / ggml_blck_size(src0->type)`, and the kernel indexes `A[lda * row + l]` on a
+    // `block_q4_0 *` for `l < k`. Passing `knl_n` here ran the contraction 32x too far off the end of
+    // every row: conformer-ctc came back with "i" instead of the sentence and took 1.94x as long.
+    // It did not show up on VITS because VITS never reaches this call at all -- its patch batches do
+    // not leave room for the Q8_0 staging and the size check above declines them.
+    llamafile_sgemm_q4_0_q8_0_cm(params, c_out, patch_n, knl_n / blck,
+                                 qk, knl_n / blck,
+                                 qb, knl_n / blck,
+                                 out, ldc);
+    return true;
+#else
+    GGML_UNUSED(params); GGML_UNUSED(qk); GGML_UNUSED(tmp); GGML_UNUSED(patches_per_batch);
+    GGML_UNUSED(patch_n); GGML_UNUSED(c_out); GGML_UNUSED(knl_n); GGML_UNUSED(out); GGML_UNUSED(ldc);
+    return false;
+#endif
+}
