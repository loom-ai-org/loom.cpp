+    // The 4, 8 or 12 rows left over by the `m - (m % 16)` prefix above. Split by COLUMN across the
+    // threads, exactly as `gemm_tail` splits the <= 3 rows left over by `matmul` -- each thread then
+    // writes a disjoint slice of C, which is the property this whole patch is about, and the barrier
+    // ending gemm() has already run by the time this is called.
+    //
+    // These rows keep the 4xRN tile: they are a row REMAINDER, not a ragged edge, so there is no
+    // reason to drop to the 1x1 kernel `gemm_tail` has to use.
+    template <int RN>
+    NOINLINE void gemm_rows(int64_t i0, int64_t i1, int64_t n) {
+        const int64_t j0 = (params->ith * n) / params->nth;
+        const int64_t j1 = ((params->ith + 1) * n) / params->nth;
+        for (int64_t i = i0; i < i1; i += 4) {
+            int64_t j = j0;
+            for (; j + RN <= j1; j += RN)
+                gemm_bloc<4, RN>(i, j);
+            for (; j < j1; ++j)
+                gemm_bloc<4, 1>(i, j);
+        }
+    }
