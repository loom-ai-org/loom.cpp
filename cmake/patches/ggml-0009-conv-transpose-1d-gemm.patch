diff --git a/src/ggml-cpu/ops.h b/src/ggml-cpu/ops.h
index f009f789..56dcfe74 100644
--- a/src/ggml-cpu/ops.h
+++ b/src/ggml-cpu/ops.h
@@ -64,6 +64,39 @@ void ggml_compute_forward_soft_max_ext_back(const struct ggml_compute_params * p
