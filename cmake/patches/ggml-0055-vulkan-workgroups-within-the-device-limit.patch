+    // its loop unroller -- over 14 minutes of CPU, never done -- and compiles it in 0.65 s with
+    // V3D_DEBUG=noloopunroll, with every MUL_MAT case correct. Only that driver reads the variable,
+    // and it reads it when the loader loads it, which is the first Vulkan call below, so this has to
+    // come first. A value the user set is extended, not replaced.
+    {
+        const char * v3d_debug = getenv("V3D_DEBUG");
+        if (v3d_debug == nullptr || *v3d_debug == '\0') {
+            setenv("V3D_DEBUG", "noloopunroll", 0);
+        } else if (strstr(v3d_debug, "noloopunroll") == nullptr) {
+            const std::string extended = std::string(v3d_debug) + ",noloopunroll";
+            setenv("V3D_DEBUG", extended.c_str(), 1);
+        }
+    }
+#endif
