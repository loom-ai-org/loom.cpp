+// The workgroup a shader whose default is `size` along dimension `dim` actually runs with on `device`:
+// `size` when the device allows it, else the largest power of two it does. ggml_vk_fit_workgroup_size
+// applies this to pipelines; a dispatch that counts WORKGROUPS rather than invocations (SET_ROWS)
+// must use it too.
+static uint32_t ggml_vk_fitted_workgroup(const vk_device & device, uint32_t size, int dim = 0) {
+    const uint32_t limit = std::min(device->properties.limits.maxComputeWorkGroupInvocations,
+                                    device->properties.limits.maxComputeWorkGroupSize[dim]);
+    if (size <= limit) {
+        return size;
+    }
+    uint32_t fitted = 1;
+    while (fitted * 2 <= limit) {
+        fitted *= 2;
+    }
+    return fitted;
+}
+
+// Fits a pipeline whose workgroup size is a specialization constant to a device that allows fewer
+// invocations than the shader's default, e.g. the Raspberry Pi 4's V3D (256; 32 shaders default to
+// 512). Exceeding maxComputeWorkGroupInvocations is invalid usage, and Mesa's V3DV compiles such a
+// pipeline without complaint and computes garbage, so this is a correctness fix rather than tuning.
+//
+// It reads the SPIR-V instead of trusting each call site: the one dimension whose size is a spec
+// constant, its SpecId and default come from the module, the value in effect is the caller's or that
+// default, and a value over the limit is fitted. That dimension's dispatch denominator follows by the
+// same factor when it is a multiple of the old size -- one element per invocation (512 -> 256) or two
+// (1024 -> 512) -- and is left alone otherwise (one workgroup per row, which the shaders reduce over
+// with a stride of the workgroup size). Spec constants the caller did not pass, up to the workgroup's
+// id, are filled with the module's own defaults so nothing else changes. A device that allows 1024
+// invocations -- the most any ggml shader asks for -- returns at once.
+static void ggml_vk_fit_workgroup_size(const vk_device & device, const std::string & name, const uint32_t * code,
+                                       size_t word_count, std::array<uint32_t, 3> & wg_denoms,
+                                       std::vector<uint32_t> & spec) {
+    const uint32_t limit = device->properties.limits.maxComputeWorkGroupInvocations;
+    if (limit >= 1024 || word_count < 5 || code[0] != spv::MagicNumber) {
+        return;
+    }
+    std::unordered_map<uint32_t, uint32_t> spec_id;        // result id -> SpecId
+    std::unordered_map<uint32_t, uint32_t> value;          // result id -> (default) scalar value
+    uint32_t wg_builtin = 0;
+    std::array<uint32_t, 3> wg_ids = {0, 0, 0};
+    std::array<uint32_t, 3> literal = {0, 0, 0};
+    for (size_t i = 5; i < word_count;) {
+        const uint32_t wc = code[i] >> spv::WordCountShift, op = code[i] & spv::OpCodeMask;
+        if (wc == 0 || i + wc > word_count) {
+            return;
+        }
+        if (op == spv::OpDecorate && wc >= 4 && code[i + 2] == spv::DecorationSpecId) {
+            spec_id[code[i + 1]] = code[i + 3];
+        } else if (op == spv::OpDecorate && wc >= 4 && code[i + 2] == spv::DecorationBuiltIn &&
+                   code[i + 3] == spv::BuiltInWorkgroupSize) {
+            wg_builtin = code[i + 1];
+        } else if ((op == spv::OpConstant || op == spv::OpSpecConstant) && wc >= 4) {
+            value[code[i + 2]] = code[i + 3];
+        } else if (op == spv::OpSpecConstantTrue && wc >= 3) {
+            value[code[i + 2]] = 1;
+        } else if (op == spv::OpSpecConstantFalse && wc >= 3) {
+            value[code[i + 2]] = 0;
+        } else if ((op == spv::OpSpecConstantComposite || op == spv::OpConstantComposite) && wc >= 6 &&
+                   code[i + 2] == wg_builtin) {
+            wg_ids = {code[i + 3], code[i + 4], code[i + 5]};
+        } else if (op == spv::OpExecutionMode && wc >= 6 && code[i + 2] == spv::ExecutionModeLocalSize) {
+            literal = {code[i + 3], code[i + 4], code[i + 5]};
+        }
+        i += wc;
+    }
+    // Exactly one dimension a spec constant, the other two literal 1s.
+    int dim = -1;
+    for (int d = 0; d < 3; d++) {
+        if (wg_ids[d] != 0 && spec_id.count(wg_ids[d])) {
+            if (dim >= 0) {
+                return;
+            }
+            dim = d;
+        } else if (wg_ids[d] != 0 && (!value.count(wg_ids[d]) || value[wg_ids[d]] != 1)) {
+            return;
+        }
+    }
+    if (dim < 0) {
+        // A literal size cannot be refitted; say so instead of letting the driver compute garbage.
+        if (literal[0] * std::max(literal[1], 1u) * std::max(literal[2], 1u) > limit) {
+            GGML_LOG_WARN("ggml_vulkan: %s needs %ux%ux%u invocations, the device allows %u\n", name.c_str(),
+                          literal[0], literal[1], literal[2], limit);
+        }
+        return;
+    }
+    const uint32_t id = spec_id[wg_ids[dim]];
+    const uint32_t current = id < spec.size() ? spec[id] : value[wg_ids[dim]];
+    const uint32_t fitted = ggml_vk_fitted_workgroup(device, current, dim);
+    if (fitted == current) {
+        return;
+    }
+    if (spec.size() <= id) {
+        std::unordered_map<uint32_t, uint32_t> default_of;  // SpecId -> default
+        for (const auto & [result, sid] : spec_id) {
+            if (value.count(result)) {
+                default_of[sid] = value[result];
+            }
+        }
+        for (uint32_t k = (uint32_t) spec.size(); k <= id; k++) {
+            spec.push_back(default_of.count(k) ? default_of[k] : 0);
+        }
+    }
+    spec[id] = fitted;
+    if (wg_denoms[dim] >= current && wg_denoms[dim] % current == 0) {
+        wg_denoms[dim] = wg_denoms[dim] / current * fitted;
+    }
+    VK_LOG_DEBUG("ggml_vk_fit_workgroup_size(" << name << "): " << current << " -> " << fitted << " (limit " << limit << ")");
+}
