+// As above, but C is [m, n] with an arbitrary row stride, so a caller can hand the GEMM a VIEW of a
+// larger output and have it write its result in place. NOTE the operands are the other way round:
+// the fast-varying axis of a mul_mat's result is src0's row index, so the patches go in src0 -- which
+// is what makes the output [patch, c_out] with a c_out stride of ldc, i.e. exactly the [OW, OH, OC]
+// layout a convolution's dst already has. See ggml_compute_forward_conv_2d_impl below.
+static void ggml_call_mul_mat_ldc(ggml_type type, const ggml_compute_params * params, int64_t m, int64_t n, int64_t k,
+                                  void * a, void * b, float * c, int64_t ldc) {
+    const ggml_type_traits * traits = ggml_get_type_traits(type);
+
+    struct ggml_tensor src0 = {};
+    src0.type  = type;
+    src0.ne[0] = k;
+    src0.ne[1] = m;
+    src0.ne[2] = 1;
+    src0.ne[3] = 1;
+    src0.nb[0] = traits->type_size;
+    src0.nb[1] = k * traits->type_size;
+    src0.nb[2] = src0.nb[1];
+    src0.nb[3] = src0.nb[2];
+    src0.data  = a;
+
+    struct ggml_tensor src1 = {};
+    src1.type  = type;
+    src1.ne[0] = k;
+    src1.ne[1] = n;
+    src1.ne[2] = 1;
+    src1.ne[3] = 1;
+    src1.nb[0] = traits->type_size;
+    src1.nb[1] = k * traits->type_size;
+    src1.nb[2] = src1.nb[1];
+    src1.nb[3] = src1.nb[2];
+    src1.data  = b;
+
+    struct ggml_tensor dst = {};
+    dst.ne[0] = m;
+    dst.ne[1] = n;
+    dst.ne[2] = 1;
+    dst.ne[3] = 1;
+    dst.nb[0] = sizeof(float);
+    dst.nb[1] = ldc * sizeof(float);
+    dst.nb[2] = dst.nb[1];
+    dst.nb[3] = dst.nb[2];
+    dst.data  = c;
+
+    dst.src[0] = &src0;
+    dst.src[1] = &src1;
+
+    ggml_compute_forward_mul_mat(params, &dst);
+}
+
 static inline int64_t ggml_wrap_around(int64_t coord, int64_t size) {
     return (coord  + size) % size; // adding size avoids negative number weirdness
 }
