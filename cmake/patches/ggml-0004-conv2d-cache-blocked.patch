 // ggml_compute_forward_conv_2d
 
 
@@ -6979,7 +7055,39 @@ static void ggml_compute_forward_conv_2d_impl(const ggml_compute_params * params
     const int64_t patch_total     = dst->ne[3] * dst_w * dst_h;
 
     const int64_t space_per_patch   = knl_n * traits->type_size + c_out * sizeof(float);
-    const int64_t batch_size        = params->wsize / space_per_patch;
+
+    // WHY THE BATCH IS CAPPED WELL BELOW THE WORK BUFFER. The whole point of doing im2col a batch at a
+    // time is that the patches are written and then immediately read by the GEMM, so they never need
+    // to reach DRAM -- but that only holds if a batch FITS IN CACHE. At the stock 16 MB the batch is
+    // larger than most last-level caches, the patches are written out and read back exactly as a
+    // full im2col matrix would be, and this op is then a slower way to do the same thing. Measured on
+    // a Cortex-A72 (1 MB L2) over a VITS vocoder's eleven convolution shapes, against ggml's
+    // im2col + mul_mat: 16 MB is 0.97x -- i.e. this op loses -- 2 MB is 1.03x, 1 MB 1.12x, **512 KB
+    // 1.16x**, 256 KB 1.07x. Half the L2 is the peak because the kernel panel and the output slice
+    // have to live there too.
+    //
+    // The second clause is for convolutions small enough that the whole thing already fits: splitting
+    // those only costs barriers and shrinks the GEMM. Without it, the two shortest shapes measured
+    // 0.98x and 0.92x; with it they are 0.98x and 1.02x, and the weighted total goes 1.16x -> 1.18x.
+    // KILL SWITCH. Everything above is a heuristic tuned on two machines, so a box it mispredicts
+    // needs an escape that is not a rebuild. Spelled like ggml's own GGML_CPU_DISABLE_FUSION.
+    //
+    // IT IS THE WRONG SWITCH TO MEASURE THIS DECISION WITH, though, because it also disables
+    // ggml_conv_1d_direct_ok -- one variable, two decisions, and a whole-model timing taken with it
+    // cannot be attributed to either. `GGML_CPU_CONV2D_PATCH_BUDGET` moves only this cap and
+    // `GGML_CPU_CONV1D_BUDGET` only the predicate; measure with those. This one stays the coarse
+    // escape it was written to be.
+    static int conv_heur_off = -1;
+    if (conv_heur_off < 0) {
+        const char * e = getenv("GGML_CPU_DISABLE_CONV_HEURISTICS");
+        conv_heur_off = (e && e[0] && e[0] != '0') ? 1 : 0;
+    }
+    const int64_t patch_budget      = ggml_conv_2d_patch_budget();
+    const int64_t wbudget           = (!conv_heur_off && patch_budget > 0
+                                       && patch_total * space_per_patch > 3 * patch_budget)
+                                        ? MIN((int64_t) params->wsize, patch_budget)
+                                        : (int64_t) params->wsize;
+    const int64_t batch_size        = wbudget / space_per_patch;
     const int64_t patches_per_batch = batch_size > 8 ? (batch_size / 8) * 8 : batch_size;
     const int64_t batch_n           = (patch_total + patches_per_batch - 1) / patches_per_batch;
 
@@ -7036,6 +7144,19 @@ static void ggml_compute_forward_conv_2d_impl(const ggml_compute_params * params
 
         ggml_barrier(params->threadpool);
 
+        // The GEMM can write straight into dst when dst is contiguous and there is one image in the
+        // batch: `C[ldc*oc + p]` with `ldc = dst_w*dst_h` IS the [OW, OH, OC] layout, so the scratch
+        // buffer and the element-at-a-time scatter below are both unnecessary. That scatter is not
+        // free -- it is one strided store per output element, 2.35 M of them for a single vocoder
+        // conv -- and skipping it is most of what makes this op worth using at all: with the cache
+        // budget above but WITHOUT this, the same eleven shapes measure 1.08x instead of 1.18x.
+        if (dst->ne[3] == 1 && ggml_is_contiguous(dst)) {
+            ggml_call_mul_mat_ldc(kernel_type, params, patch_n, c_out, knl_n, tmp, knl_data,
+                                  dst_data + patch_start_batch, dst_w * dst_h);
+            ggml_barrier(params->threadpool);
+            continue;
+        }
+
         float * gemm_output = (float *) ((char *) tmp + patches_per_batch * knl_n * traits->type_size);
 
         GGML_ASSERT(gemm_output + patch_n * c_out <= (float*)tmp + params->wsize);
