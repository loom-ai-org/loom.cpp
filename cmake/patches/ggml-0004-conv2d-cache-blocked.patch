+// How many bytes of im2col patches one batch may hold -- see the block inside
+// ggml_compute_forward_conv_2d_impl for what the number is and why. A function only so that it can
+// have an override and a per-architecture arm, both of which it turned out to need.
+//
+// ZERO MEANS NO CAP: one batch, as large as the work buffer allows. That is NOT the same as
+// GGML_CPU_DISABLE_CONV_HEURISTICS, which also turns off the direct-1d predicate -- one variable,
+// two decisions, so a whole-model timing taken with it belongs to neither on its own. On ARMv6 this
+// cap is worth 1.061x by itself and that number took a knob of its own to get.
+static int64_t ggml_conv_2d_patch_budget(void) {
+    static int64_t budget = -1;
+    if (budget < 0) {
+        const char * e = getenv("GGML_CPU_CONV2D_PATCH_BUDGET");
+        if (e && e[0]) {
+            char * end = NULL;
+            const long long v = strtoll(e, &end, 10);
+            if (end != e && *end == '\0' && v >= 0) {
+                budget = (int64_t) v;
+                return budget;
+            }
+        }
+        budget = 512 * 1024;
+    }
+    return budget;
+}
