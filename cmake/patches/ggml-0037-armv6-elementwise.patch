new file mode 100644
index 00000000..05f58c1c
--- /dev/null
+++ b/src/ggml-cpu/armv6-eltwise.h
@@ -0,0 +1,158 @@
+#pragma once
+
+// ---------------------------------------------------------------------------------------------
+// ARMv6 ONLY: THE ELEMENTWISE PASSES AT MEMORY SPEED (loom ggml-0037, ADR-079 item P4.32f f2).
+//
+// On the VFP11 ggml's elementwise loops are not memory-bound, they are latency-bound. Per element, on
+// a Pi Zero W over a cold 12.5 MB tensor (loom scripts/bench55.cpp, one thread, RunFast and IEEE alike):
+//
+//                                   stock   here
+//     ADD, same shape              68.3    36.4   (two input streams)
+//     ADD of a [1, C] bias         43.3    11.6   (ggml calls its row loop once PER ELEMENT for it)
+//     MUL by a [1, 1] scalar       43.3    11.6   = memcpy's 11.9: one stream in, one out
+//     LEAKY_RELU                   63.8    23.0   (compute-bound now: 18.9 with the data in L1)
+//
+// Two things cost that. Every loop is one load, one VFP op and one store that waits on it, so the
+// VFP11's 8-cycle latency is paid per element; and nothing prefetches, so every 32-byte line is a full
+// DRAM round trip. The compare in LEAKY_RELU and RELU (`vcmpe` + `vmrs`) also drains the VFP pipeline
+// per element. Here: eight floats per step through `vldmia`/`vstmia`, eight independent VFP ops, one
+// `pld` per input line GGML_ARMV6_ELTWISE_PLD bytes ahead, and the compares done on the integer bits.
+//
+// THE INPUT IS BROUGHT TO A 32-BYTE LINE FIRST. A `vldmia` of eight floats that straddles two lines
+// nearly doubles a cold stream on the ARM1176: the same multiply ran 20.9 ns an element from a buffer
+// 8 bytes off a line and 11.6 from an aligned one, and a plain copy 21.0 against 11.1 (loom
+// scripts/bench55_streams.cpp).
+// ggml's buffers are 32-byte aligned but a row of 551 floats is not, so up to seven elements go scalar.
+// The `pld` distance does not matter: 96 to 1024 bytes all measured within 0.3 ns.
+//
+// EVERY RESULT IS BIT-IDENTICAL to the stock loop: the same IEEE operation on the same operands, in
+// any order, and the integer compares are exactly the VFP's (see ggml_armv6_pos_lo). `pld` on the
+// OUTPUT is not done: the ARM1176 does not allocate on a store, so it only costs a read (P4.32e).
+//
+// GGML_CPU_ARMV6_ELTWISE=0 turns all of it off (read once per process), for A/B runs.
+// ---------------------------------------------------------------------------------------------
+
+#if defined(__ARM_FEATURE_SIMD32) && !defined(__ARM_NEON) && !defined(__aarch64__)
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+#define GGML_ARMV6_ELTWISE 1
+
+#ifndef GGML_ARMV6_ELTWISE_PLD
+#define GGML_ARMV6_ELTWISE_PLD 256
+#endif
+
+static inline bool ggml_armv6_eltwise_on(void) {
+    static const bool on = [] {
+        const char * e = getenv("GGML_CPU_ARMV6_ELTWISE");
+        return !(e && atoi(e) == 0);
+    }();
+    return on;
+}
+
+// x > 0 as the VFP decides it is, on the bits: lo <= u <= 0x7f800000 as unsigned. -0, every negative,
+// every NaN, and under RunFast's flush-to-zero (FPSCR.FZ, which makes the compare see a positive denormal
+// as 0) every positive denormal fall outside, so lo is the smallest positive normal under FZ and 1 in
+// IEEE mode. x < 0 is the same range with the sign bit set. (The ggml-0036 epilogue's RELU, same test.)
+static inline uint32_t ggml_armv6_pos_lo(void) {
+    uint32_t f;
+    __asm__ volatile("vmrs %0, fpscr" : "=r"(f));
+    return (f & (1u << 24)) ? 0x00800000u : 1u;
+}
+
+// z = x OP y over n floats, and z = x OP s. z may BE x or y (ggml's in-place ops); it may not partially
+// overlap either, which no ggml graph does.
+#define GGML_ARMV6_BINARY(NAME, INSN, CEXPR)                                                            \
+static inline void ggml_armv6_##NAME(int32_t n, float * z, const float * x, const float * y) {          \
+    for (; n > 0 && ((uintptr_t) x & 31); --n, ++x, ++y, ++z) { const float a = *x, b = *y; *z = CEXPR; } \
+    int32_t blocks = n >> 3;                                                                            \
+    if (blocks) {                                                                                       \
+        __asm__ volatile(                                                                               \
+            "1:\n\t"                                                                                    \
+            "pld [%[x], %[d]]\n\t"                                                                      \
+            "pld [%[y], %[d]]\n\t"                                                                      \
+            "vldmia %[x]!, {s0-s7}\n\t"                                                                 \
+            "vldmia %[y]!, {s8-s15}\n\t"                                                                \
+            INSN " s0, s0, s8\n\t"  INSN " s1, s1, s9\n\t"  INSN " s2, s2, s10\n\t" INSN " s3, s3, s11\n\t" \
+            INSN " s4, s4, s12\n\t" INSN " s5, s5, s13\n\t" INSN " s6, s6, s14\n\t" INSN " s7, s7, s15\n\t" \
+            "subs %[b], %[b], #1\n\t"                                                                   \
+            "vstmia %[z]!, {s0-s7}\n\t"                                                                 \
+            "bne 1b\n\t"                                                                                \
+            : [x] "+r"(x), [y] "+r"(y), [z] "+r"(z), [b] "+r"(blocks)                                   \
+            : [d] "I"(GGML_ARMV6_ELTWISE_PLD)                                                           \
+            : "s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7", "s8", "s9", "s10", "s11", "s12", "s13",   \
+              "s14", "s15", "cc", "memory");                                                            \
+    }                                                                                                   \
+    for (int32_t i = 0; i < (n & 7); ++i) { const float a = x[i], b = y[i]; z[i] = CEXPR; }           \
+}                                                                                                       \
+static inline void ggml_armv6_##NAME##_s(int32_t n, float * z, const float * x, float s) {              \
+    for (; n > 0 && ((uintptr_t) x & 31); --n, ++x, ++z) { const float a = *x, b = s; *z = CEXPR; }      \
+    int32_t blocks = n >> 3;                                                                            \
+    if (blocks) {                                                                                       \
+        __asm__ volatile(                                                                               \
+            "vmov s8, %[s]\n\t"                                                                         \
+            "1:\n\t"                                                                                    \
+            "pld [%[x], %[d]]\n\t"                                                                      \
+            "vldmia %[x]!, {s0-s7}\n\t"                                                                 \
+            INSN " s0, s0, s8\n\t" INSN " s1, s1, s8\n\t" INSN " s2, s2, s8\n\t" INSN " s3, s3, s8\n\t" \
+            INSN " s4, s4, s8\n\t" INSN " s5, s5, s8\n\t" INSN " s6, s6, s8\n\t" INSN " s7, s7, s8\n\t" \
+            "subs %[b], %[b], #1\n\t"                                                                   \
+            "vstmia %[z]!, {s0-s7}\n\t"                                                                 \
+            "bne 1b\n\t"                                                                                \
+            : [x] "+r"(x), [z] "+r"(z), [b] "+r"(blocks)                                                \
+            : [d] "I"(GGML_ARMV6_ELTWISE_PLD), [s] "r"(s)                                               \
+            : "s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7", "s8", "cc", "memory");                    \
+    }                                                                                                   \
+    for (int32_t i = 0; i < (n & 7); ++i) { const float a = x[i], b = s; z[i] = CEXPR; }              \
+}
+
+GGML_ARMV6_BINARY(add, "vadd.f32", a + b)
+GGML_ARMV6_BINARY(sub, "vsub.f32", a - b)
+GGML_ARMV6_BINARY(mul, "vmul.f32", a * b)
+
+#undef GGML_ARMV6_BINARY
+
+// y = (x > 0 ? x : 0) + ns * (x < 0 ? x : 0) -- ggml_vec_leaky_relu_f32's own arithmetic, with its two
+// compares on the bits. (A plain `x > 0 ? x : ns*x` differs: NaN and -0 both come out +0 here.)
+static inline void ggml_armv6_leaky_relu(int32_t n, float * y, const float * x, float ns) {
+    const uint32_t lo   = ggml_armv6_pos_lo();
+    const uint32_t span = 0x7f800000u - lo;
+    const uint32_t * u  = (const uint32_t *) x;
+    auto one = [&](int32_t j) {
+        const uint32_t b = u[j];
+        const uint32_t p = b - lo <= span ? b : 0u;
+        const uint32_t q = b - (0x80000000u + lo) <= span ? b : 0u;
+        float fp, fq;
+        memcpy(&fp, &p, 4);
+        memcpy(&fq, &q, 4);
+        return fp + ns * fq;
+    };
+    int32_t i = 0;
+    for (; i + 8 <= n; i += 8) {
+        __builtin_prefetch((const char *) (x + i) + GGML_ARMV6_ELTWISE_PLD);
+        float a[8];
+        for (int k = 0; k < 8; ++k) a[k] = one(i + k);
+        for (int k = 0; k < 8; ++k) y[i + k] = a[k];
+    }
+    for (; i < n; ++i) y[i] = one(i);
+}
+
+// y = x > 0 ? x : 0, entirely on the bits
+static inline void ggml_armv6_relu(int32_t n, float * y, const float * x) {
+    const uint32_t lo   = ggml_armv6_pos_lo();
+    const uint32_t span = 0x7f800000u - lo;
+    const uint32_t * u  = (const uint32_t *) x;
+    uint32_t *       v  = (uint32_t *) y;
+    int32_t i = 0;
+    for (; i + 8 <= n; i += 8) {
+        __builtin_prefetch((const char *) (u + i) + GGML_ARMV6_ELTWISE_PLD);
+        uint32_t a[8];
+        for (int k = 0; k < 8; ++k) a[k] = u[i + k] - lo <= span ? u[i + k] : 0u;
+        for (int k = 0; k < 8; ++k) v[i + k] = a[k];
+    }
+    for (; i < n; ++i) v[i] = u[i] - lo <= span ? u[i] : 0u;
+}
+
+#endif
