+#elif defined(__SSE__) && (defined(__x86_64__) || defined(_M_X64))
+        // loom ggml-0060: x86 without AVX (SSE4.2 Atoms and Celerons). Every helper this needs was already
+        // here for __m128 -- madd is multiply then add, there being no FMA -- only this arm was missing, so
