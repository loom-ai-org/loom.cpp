+// Nor does MSVC define them under /arch:SSE4.2 -- not even __SSE__ (checked, MSVC 19.44) -- so the sse42 variant
+// (GGML_SSE42 is the only definition CMake gives it there) compiled every GGML_SIMD path as scalar C. clang-cl
+// defines its own. loom ggml-0060; on a Celeron N4100 this alone took Zipformer small F32 from RTF 0.503 to
+// 0.179, VITS 0.597 -> 0.322, Matcha 6.01 -> 3.82, with identical transcripts.
+#if defined(_MSC_VER) && !defined(__clang__) && defined(GGML_SSE42)
+#ifndef __SSE__
+#define __SSE__
+#endif
+#ifndef __SSE2__
+#define __SSE2__
+#endif
+#ifndef __SSE3__
+#define __SSE3__
+#endif
+#ifndef __SSSE3__
+#define __SSSE3__
+#endif
+#ifndef __SSE4_1__
+#define __SSE4_1__
+#endif
+#ifndef __SSE4_2__
+#define __SSE4_2__
+#endif
+#endif
+
 #if defined(__s390x__) && defined(__VEC__)
