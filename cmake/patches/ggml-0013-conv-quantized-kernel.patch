+// ggml_conv_2d_direct_packed
+
+struct ggml_tensor * ggml_conv_2d_direct_packed(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,   // convolution kernel [IC*KH*KW, OC]
+        struct ggml_tensor  * b,   // input data [W, H, C, N]
+        int                   s0,
+        int                   s1,
+        int                   p0,
+        int                   p1,
+        int                   d0,
+        int                   d1,
+        int                   kw,
+        int                   kh,
+        int                   ic) {
+
+    // The geometry is CHECKED against the tensor rather than trusted, because a folded [IC*KH*KW, OC]
+    // and a declared [KW, KH, IC] are indistinguishable by shape: a disagreement here is a wrong
+    // convolution computed silently, everywhere else.
+    GGML_ASSERT(kw > 0 && kh > 0 && ic > 0);
+    GGML_ASSERT(a->ne[0] == (int64_t) kw * kh * ic);
+    GGML_ASSERT(a->ne[2] == 1 && a->ne[3] == 1);
+    GGML_ASSERT(ic == b->ne[2]);
+    GGML_ASSERT(ggml_is_contiguous(a));
+
+    int64_t ne[4];
+    ne[0] = ggml_calc_conv_output_size(b->ne[0], kw, s0, p0, d0);
+    ne[1] = ggml_calc_conv_output_size(b->ne[1], kh, s1, p1, d1);
+    ne[2] = a->ne[1];   // OC, the one axis the fold leaves alone
+    ne[3] = b->ne[3];
+
+    struct ggml_tensor * result = ggml_new_tensor(ctx, b->type, 4, ne);
+
+    ggml_set_op_params_i32(result, 0, s0);
+    ggml_set_op_params_i32(result, 1, s1);
+    ggml_set_op_params_i32(result, 2, p0);
+    ggml_set_op_params_i32(result, 3, p1);
+    ggml_set_op_params_i32(result, 4, d0);
+    ggml_set_op_params_i32(result, 5, d1);
+    // 6..8 are the fold, and their ABSENCE (a zero kw, which ggml_new_tensor zeroes op_params to) is
+    // what says a kernel is in the declared layout. GGML_MAX_OP_PARAMS is 64 bytes; this uses 36.
+    ggml_set_op_params_i32(result, 6, kw);
+    ggml_set_op_params_i32(result, 7, kh);
+    ggml_set_op_params_i32(result, 8, ic);
+
+    result->op = GGML_OP_CONV_2D;
+    result->src[0] = a;
+    result->src[1] = b;
+
+    return result;
+}
