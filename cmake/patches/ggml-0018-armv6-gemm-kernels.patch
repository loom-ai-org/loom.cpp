+// ARMv6 -- ARM1176, i.e. Raspberry Pi Zero / Zero W / Pi 1. This is NOT one of the 64-bit ARMs, which
+// are served by the NEON and DOTPROD arms throughout this file; it is the 32-bit v6 floor, which has
+// no NEON at all and instead has the SIMD32/DSP instructions on the general-purpose registers.
+//
+// `!defined(__ARM_NEON)` IS LOAD-BEARING AND ARMv7 IS WHY. SIMD32 is not an ARMv6 feature that ARMv7
+// dropped -- ARMv7-A has it too, so this guard without the NEON clause would capture every 32-bit
+// Raspberry Pi OS install on a Pi 2/3/4 as well. That would be a REGRESSION, not a win: ARMv7-A has
+// NEON, whose `vmull_s8` does eight 8-bit MACs against `__smlad`'s two, and ggml's
+// `vec_dot_q4_0_q8_0` already has a NEON arm (arch/arm/quants.c) that those boards take today. The
+// tiling below is what ARMv7 would want -- as a NEON kernel, which is different work. This one is
+// for the rung with no vector unit at all.
+#if defined(__ARM_FEATURE_SIMD32) && !defined(__ARM_NEON) && !defined(__aarch64__)
+#include <arm_acle.h>
+#endif
+
