+static inline float ggml_expf_minus_max(float vx) {
+    const float vlog2e         =  0x1.715476p+0f;
+    const float vmagic_bias    =  0x1.8000FEp23f;
+    const float vminus_ln2_hi  = -0x1.62E400p-1f;
+    const float vminus_ln2_lo  = -0x1.7F7D1Cp-20f;
+    const float vc5            =  0x1.0F9F9Cp-7f;
+    const float vc4            =  0x1.573A1Ap-5f;
+    const float vc3            =  0x1.555A80p-3f;
+    const float vc2            =  0x1.FFFDC6p-2f;
+    const float vc1            =  0x1.FFFFF6p-1f;
+    const float vdenorm_cutoff = -0x1.5D589Ep6f;
+
+    // XNNPACK runs the arithmetic on every input and zeroes the ones below the cutoff at the end. Here the
+    // input is first REPLACED by 0 when it is below the cutoff: a masked -inf would otherwise go through
+    // vn*ln2 + vx = inf - inf
+    // = NaN, and the ARM1176's VFP does not handle an invalid operation in hardware -- it traps to the
+    // kernel's support code. On a Pi Zero that made a causal-masked softmax 18x SLOWER than libm's expf
+    // (22.4 s against 1.25 s, 2 x 1500 x 1500). Do NOT turn this into an early return: a branch per element
+    // stops the compiler interleaving the four independent chains of the unrolled loop, and dense rows lost
+    // their whole gain (666 ms back to 1130 against libm's 1101). A select is a predicated move here. And
+    // 0, not the cutoff itself: at the cutoff `vt*vs` is denormal, which traps on that VFP just the same.
+    const float vxc = vx < vdenorm_cutoff ? 0.0f : vx;
+    float vn = vxc*vlog2e + vmagic_bias;
+    uint32_t bits;
+    memcpy(&bits, &vn, sizeof(bits));
+    bits <<= 23;
+    float vs;
+    memcpy(&vs, &bits, sizeof(vs));
+    vn -= vmagic_bias;
+    float vt = vn*vminus_ln2_hi + vxc;
+    vt = vn*vminus_ln2_lo + vt;
+    float vp = vc5*vt + vc4;
+    vp = vp*vt + vc3;
+    vp = vp*vt + vc2;
+    vp = vp*vt + vc1;
+    vt *= vs;
+    const float vf = vt*vp + vs;
+    return vx < vdenorm_cutoff ? 0.0f : vf;
+}
