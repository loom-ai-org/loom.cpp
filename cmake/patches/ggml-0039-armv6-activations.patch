@@ -2404,6 +2404,56 @@ void ggml_compute_forward_tri(const ggml_compute_params * params, ggml_tensor *
 
 // ggml_compute_forward_gelu_erf
 
+#if defined(__ARM_FEATURE_SIMD32) && !defined(__ARM_NEON) && !defined(__aarch64__)
+// ---------------------------------------------------------------------------------------------
+// ARMv6 ONLY: ACTIVATIONS ON THE VFP11's SHORT VECTORS (loom ggml-0039, ADR-079 P4.32f f2 step 3a).
+// Generated by loom scripts/gen_armv6_act_f32.py, which explains each kernel. GGML_CPU_ARMV6_ACT=0
+// turns them off (read once).
+#include "arch/arm/armv6-act-f32.inc"
+
+static bool ggml_armv6_act_on(void) {
+    static const bool on = [] {
+        const char * e = getenv("GGML_CPU_ARMV6_ACT");
+        return !(e && atoi(e) == 0);
+    }();
+    return on;
+}
+
+// One row of n floats through kernel `kind` (0 gelu_erf, 1 sigmoid, 2 silu, 3 tanh): whole blocks of 8 in
+// place or not, then the last n % 8 through the same kernel on a padded copy, so that one tensor is one
+// function. False, having done nothing, when the kernels are off. Also called from unary-ops.cpp.
+bool ggml_armv6_act_row(int kind, int64_t n, float * y, const float * x) {
+    typedef void (*fn_t)(const ggml_armv6_act_args *);
+    static const fn_t fns[4] = { ggml_armv6_gelu_erf_f32, ggml_armv6_sigmoid_f32, ggml_armv6_silu_f32,
+                                 ggml_armv6_tanh_f32 };
+    if (!ggml_armv6_act_on() || n > INT32_MAX) return false;
+    float sc[32];
+    const int64_t n8 = n / 8;
+    if (n8 > 0) {
+        const ggml_armv6_act_args a = { x, y, sc, (int32_t) n8 };
+        fns[kind](&a);
+    }
+    const int64_t r = n - n8 * 8;
+    if (r > 0) {
+        float in[8] = { 0 }, out[8];
+        memcpy(in, x + n8 * 8, (size_t) r * sizeof(float));
+        const ggml_armv6_act_args a = { in, out, sc, 1 };
+        fns[kind](&a);
+        memcpy(y + n8 * 8, out, (size_t) r * sizeof(float));
+    }
+    return true;
+}
+
+// GGML_CPU_DISABLE_GELU_ERF_SIMD=1 asks ggml_vec_gelu_erf_f32 for libm's erff; the kernel stands aside.
+static bool ggml_gelu_erf_libm_requested(void) {
+    static const bool libm = [] {
+        const char * e = getenv("GGML_CPU_DISABLE_GELU_ERF_SIMD");
+        return e && e[0] && e[0] != '0';
+    }();
+    return libm;
+}
+#endif
