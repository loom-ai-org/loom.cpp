-// One row of n floats through kernel `kind` (0 gelu_erf, 1 sigmoid, 2 silu, 3 tanh): whole blocks of 8 in
+// One row of n floats through kernel `kind` (0 gelu_erf, 1 sigmoid, 2 silu, 3 tanh, 4 elu): blocks of 8 in
 // place or not, then the last n % 8 through the same kernel on a padded copy, so that one tensor is one
 // function. False, having done nothing, when the kernels are off. Also called from unary-ops.cpp.
 bool ggml_armv6_act_row(int kind, int64_t n, float * y, const float * x) {
     typedef void (*fn_t)(const ggml_armv6_act_args *);
-    static const fn_t fns[4] = { ggml_armv6_gelu_erf_f32, ggml_armv6_sigmoid_f32, ggml_armv6_silu_f32,
-                                 ggml_armv6_tanh_f32 };
+    static const fn_t fns[5] = { ggml_armv6_gelu_erf_f32, ggml_armv6_sigmoid_f32, ggml_armv6_silu_f32,
+                                 ggml_armv6_tanh_f32, ggml_armv6_elu_f32 };   // ELU: ggml-0052
     if (!ggml_armv6_act_on() || n > INT32_MAX) return false;
     float sc[32];
     const int64_t n8 = n / 8;
