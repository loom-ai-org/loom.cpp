 }
+
+#if defined(__aarch64__)
+size_t llamafile_sgemm_f32_wsize(void) {
+    return sgemm_op_wsize();
+}
+
+// NOT reached through llamafile_sgemm: this path packs into params->wdata, and the convolutions' im2col
+// fallback (ops.cpp's ggml_call_mul_mat*) calls mul_mat with its own patches already there -- so only a
+// graph MUL_MAT node, whose work buffer ggml_graph_plan sized for this, may call it. Taking the path from
+// llamafile_sgemm overwrote the patches: loom's conv_1d / conv_transpose_1d sweeps and STFT test went
+// to relative errors of 0.9-1.5 on the Pi 4. ARMv6's packed F32 GEMM (ggml-0034) hit the same thing.
+bool llamafile_sgemm_f32_packed(const struct ggml_compute_params * params, int64_t m, int64_t n, int64_t k,
+                                const float * A, int64_t lda, const float * B, int64_t ldb, float * C, int64_t ldc) {
+    if (params->use_ref || !sgemm_op_admits(params, m, n, k))
+        return false;
+    sgemm_op(params, m, n, k, A, lda, B, ldb, C, ldc);
+    return true;
+}
+#endif
