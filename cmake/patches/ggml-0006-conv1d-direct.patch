+// The phase-major path: de-interleave, run the dense kernel per phase, interleave back.
+static void ggml_conv_1d_phase_run(const ggml_compute_params * params,
+                                   const ggml_tensor * kernel, const ggml_tensor * src,
+                                   ggml_tensor * dst, const float * bias_data, float * out_data,
+                                   int64_t J) {
+    const int64_t IC  = src->ne[2];
+    const int64_t OC  = dst->ne[2];
+    const int64_t KW  = kernel->ne[0];
+    const int64_t L   = src->ne[0];
+    const int64_t OL  = dst->ne[0];
+    const int64_t dil = ggml_get_op_params_i32(dst, 4);
+    const int64_t H   = (KW - 1) / 2;
+    const int64_t JP  = J + 2*H;
+
+    int a, b; ggml_conv1d_phase_factors(dil, &a, &b);
+    const int64_t na   = (L  + a - 1) / a;
+    const int64_t nb   = (OL + a - 1) / a;
+    const int64_t nmax = (na > nb ? na : nb) + 1;      // one slice per thread, sized for either pass
+
+    const float * x = (const float *) src->data;
+    const float * w = (const float *) kernel->data;
+    float *       y = out_data ? out_data : (float *) dst->data;
+
+    float * xp  = (float *) params->wdata;              // [IC, dil, JP]
+    float * yp  = xp + (size_t) IC * dil * JP;          // [OC, dil, J]
+    float * wp  = yp + (size_t) OC * dil * J;           // [IC, KW, OC]
+    float * tmp = wp + (size_t) IC * KW * OC;           // two-pass scratch, per thread below
+
+    for (int64_t ic = params->ith; ic < IC; ic += params->nth) {
+        float * base = xp + ic * dil * JP;
+        memset(base, 0, (size_t) dil * JP * sizeof(float));
+        if (b == 1) {
+            ggml_conv1d_deint(x + ic*L, base + H, JP, L, a);
+        } else {
+            float * t = tmp + (size_t) params->ith * a * nmax;
+            ggml_conv1d_deint(x + ic*L, t, nmax, L, a);
+            for (int r1 = 0; r1 < a; ++r1)
+                ggml_conv1d_deint(t + (int64_t) r1*nmax, base + (int64_t) r1*JP + H, (int64_t) a*JP, na, b);
+        }
+    }
+    for (int64_t ic = params->ith; ic < IC; ic += params->nth)
+        for (int64_t kx = 0; kx < KW; ++kx)
+            for (int64_t oc = 0; oc < OC; ++oc)
+                wp[(ic * KW + kx) * OC + oc] = w[oc * (IC * KW) + ic * KW + kx];
+
+    ggml_barrier(params->threadpool);
+
+    // Within a phase the taps are adjacent, so this is the dense kernel with dilation 1.
+    const int64_t P    = GGML_CONV1D_VEC * GGML_CONV1D_LANES;
+    const int64_t nblk = J / P;
+    const int64_t njob = dil * nblk;
+    const int64_t jper = (njob + params->nth - 1) / params->nth;      // contiguous, as above
+    const int64_t j0   = params->ith * jper;
+    const int64_t j1   = MIN(j0 + jper, njob);
+    for (int64_t job = j0; job < j1; ++job) {
+        const int64_t r = job / nblk, bkl = job % nblk;
+        for (int64_t oc0 = 0; oc0 < OC; oc0 += GGML_CONV1D_OCB)
+            ggml_conv_1d_direct_tile(xp + (size_t) r * JP, wp, bias_data, yp + (size_t) r * J,
+                                     IC, OC, KW, (int64_t) dil * JP, (int64_t) dil * J, 1,
+                                     oc0, bkl * P, GGML_CONV1D_OCB);
+    }
+    if (nblk * P < J) {                                  // overlapping tail tile, as in the direct path
+        const int64_t j0 = J - P;
+        for (int64_t r = params->ith; r < dil; r += params->nth)
+            for (int64_t oc0 = 0; oc0 < OC; oc0 += GGML_CONV1D_OCB)
+                ggml_conv_1d_direct_tile(xp + (size_t) r * JP, wp, bias_data, yp + (size_t) r * J,
+                                         IC, OC, KW, (int64_t) dil * JP, (int64_t) dil * J, 1,
+                                         oc0, j0, GGML_CONV1D_OCB);
+    }
+
+    ggml_barrier(params->threadpool);
+
+    for (int64_t oc = params->ith; oc < OC; oc += params->nth) {
+        const float * s = yp + (size_t) oc * dil * J;
+        if (b == 1) {
+            ggml_conv1d_inter(s, y + oc*OL, J, OL, a);
+        } else {
+            float * t = tmp + (size_t) params->ith * a * nmax;
+            for (int r1 = 0; r1 < a; ++r1)
+                ggml_conv1d_inter(s + (int64_t) r1*J, t + (int64_t) r1*nmax, (int64_t) a*J, nb, b);
+            ggml_conv1d_inter(t, y + oc*OL, nmax, OL, a);
+        }
+    }
+}
 
