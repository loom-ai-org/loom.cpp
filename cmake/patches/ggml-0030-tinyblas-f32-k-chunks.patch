+// The L1 data and L2 cache sizes of the CPU this runs on (its performance cores on Apple), read once;
+// 0 where the OS does not say, which leaves tinyBLAS's F32 path exactly as upstream has it.
+struct sgemm_caches { int64_t l1d = 0, l2 = 0; };
+
+static sgemm_caches sgemm_read_caches() {
+    sgemm_caches c;
+#if defined(__linux__)
+    for (int idx = 0; idx < 8; ++idx) {
+        char path[96], type[32] = {0}, size[32] = {0};
+        int level = 0;
+        snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu0/cache/index%d/level", idx);
+        FILE * f = fopen(path, "r");
+        if (!f) break;
+        if (fscanf(f, "%d", &level) != 1) level = 0;
+        fclose(f);
+        snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu0/cache/index%d/type", idx);
+        if ((f = fopen(path, "r"))) { if (fscanf(f, "%31s", type) != 1) type[0] = 0; fclose(f); }
+        snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu0/cache/index%d/size", idx);
+        if ((f = fopen(path, "r"))) { if (fscanf(f, "%31s", size) != 1) size[0] = 0; fclose(f); }
+        char * end = nullptr;
+        int64_t bytes = strtoll(size, &end, 10);
+        if (end && (*end == 'K' || *end == 'k')) bytes *= 1024;
+        else if (end && (*end == 'M' || *end == 'm')) bytes *= 1024 * 1024;
+        const bool data = strcmp(type, "Data") == 0 || strcmp(type, "Unified") == 0;
+        if (level == 1 && data) c.l1d = bytes;
+        if (level == 2 && data) c.l2 = bytes;
+    }
+#elif defined(__APPLE__)
+    auto read = [](const char * name, const char * fallback) -> int64_t {
+        int64_t v = 0;
+        size_t len = sizeof(v);
+        if (sysctlbyname(name, &v, &len, nullptr, 0) == 0 && v > 0) return v;
+        len = sizeof(v);
+        return sysctlbyname(fallback, &v, &len, nullptr, 0) == 0 ? v : 0;
+    };
+    c.l1d = read("hw.perflevel0.l1dcachesize", "hw.l1dcachesize");
+    c.l2  = read("hw.perflevel0.l2cachesize",  "hw.l2cachesize");
+#endif
+    return c;
+}
+
+static const sgemm_caches & sgemm_cache_sizes() {
+    static const sgemm_caches c = sgemm_read_caches();
+    return c;
+}
