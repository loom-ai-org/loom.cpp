+
 void ggml_compute_forward_conv_2d_dw(
         const ggml_compute_params * params,
         ggml_tensor * dst) {
@@ -9372,6 +9410,42 @@ void ggml_compute_forward_conv_2d_dw(
     }
 }
 
+// loom (ggml-0022): CONV_2D_DW fused with the zero PAD that feeds it and the per-channel bias ADD and
+// RELU that follow it -- see ggml_cpu_conv_2d_dw_fusion. A PAD only widens the source with zeros, which
+// is exactly what the kernel's own bounds test produces, so it folds into a larger left pad over the
+// PAD's unpadded input; the right pad needs nothing, since positions past the source read as zero
+// either way.
+void ggml_compute_forward_conv_2d_dw_fused(
+        const ggml_compute_params * params,
+        const ggml_tensor * conv,
+        const ggml_tensor * pad,
+        const ggml_tensor * bias,
+        bool relu,
+        ggml_tensor * out) {
+    const ggml_tensor * kernel = conv->src[0];
+    const ggml_tensor * src = pad != nullptr ? pad->src[0] : conv->src[1];
+    ggml_conv_2d_dw_params p;
+    p.channels = conv->src[1]->ne[2];
+    p.batch = conv->src[1]->ne[3];
+    p.src_w = src->ne[0];
+    p.src_h = 1;
+    p.dst_w = conv->ne[0];
+    p.dst_h = conv->ne[1];
+    p.knl_w = kernel->ne[0];
+    p.knl_h = kernel->ne[1];
+    p.stride_x = conv->op_params[0];
+    p.stride_y = conv->op_params[1];
+    p.pad_x = conv->op_params[2] + (pad != nullptr ? ggml_get_op_params_i32(pad, 0) : 0);
+    p.pad_y = conv->op_params[3];
+    p.dilation_x = conv->op_params[4];
+    p.dilation_y = conv->op_params[5];
+
+    GGML_ASSERT(kernel->type == GGML_TYPE_F32 || kernel->type == GGML_TYPE_F16);
+    GGML_ASSERT(p.dst_h == 1 && conv->src[1]->ne[1] == 1);
+    ggml_compute_forward_conv_2d_dw_whcn_impl(params, (const float *) src->data, kernel, (float *) out->data, p,
+                                              bias != nullptr ? (const float *) bias->data : nullptr, relu);
+}
