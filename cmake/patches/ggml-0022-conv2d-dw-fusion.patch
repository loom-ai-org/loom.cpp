+        struct ggml_tensor * conv = NULL; const struct ggml_tensor * pad = NULL;
+        const struct ggml_tensor * bias = NULL; bool relu = false; struct ggml_tensor * out = NULL;
+        const int last = ggml_cpu_conv_2d_dw_fusion(cgraph, node_n, &conv, &pad, &bias, &relu, &out);
+        if (last > node_n) {
+            ggml_compute_forward_conv_2d_dw_fused(params, conv, pad, bias, relu, out);
+            return last - node_n;
+        }
+    }
+
     if (node->op == GGML_OP_RMS_NORM) {
         // RMS_NORM + MUL fusion
         const enum ggml_op fuse_ops[] = { GGML_OP_RMS_NORM, GGML_OP_MUL };
