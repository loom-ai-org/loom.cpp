+// loom (ggml-0022): a depthwise convolution with the elementwise nodes around it. A causal temporal
+// block (WakeHuBERT, and the conformer/Moonshine conv modules) lowers to
+//
+//     p = PAD(x, left = (K-1)*d)       a full read and write of the activation
+//     c = CONV_2D_DW(w, p)
+//     b = ADD(c, bias)                 a per-channel broadcast add: ~6x the cost of a plain add here
+//     r = RELU(b)                      optional
+//
+// and all of it is one pass of the depthwise kernel. Matched from the PAD when the convolution is its
+// only consumer, otherwise from the convolution; each neighbour is optional. Fills the out-params and
+// returns the index of the LAST node covered, else -1.
+static int ggml_cpu_conv_2d_dw_fusion(const struct ggml_cgraph * cgraph, int node_n,
+                                      struct ggml_tensor ** conv_out, const struct ggml_tensor ** pad_out,
+                                      const struct ggml_tensor ** bias_out, bool * relu_out,
+                                      struct ggml_tensor ** out_out) {
+    int idx = node_n;
+    struct ggml_tensor * node = cgraph->nodes[idx];
+    const struct ggml_tensor * pad = NULL;
+
+    if (node->op == GGML_OP_PAD) {
+        const struct ggml_tensor * in = node->src[0];
+        if (node->type != GGML_TYPE_F32 || !ggml_is_contiguous(node) || in == NULL ||
+            in->type != GGML_TYPE_F32 || !ggml_is_contiguous(in) ||
+            ggml_get_op_params_i32(node, 8) != 0 ||                    // circular
+            ggml_get_op_params_i32(node, 0) < 0 || ggml_get_op_params_i32(node, 1) < 0) {
+            return -1;
+        }
+        for (int k = 2; k < 8; ++k) {
+            if (ggml_get_op_params_i32(node, k) != 0) {
+                return -1;
+            }
+        }
+        if (in->ne[1] != node->ne[1] || in->ne[2] != node->ne[2] || in->ne[3] != node->ne[3]) {
+            return -1;
+        }
+        idx = ggml_cpu_next_compute_node(cgraph, idx + 1);
+        if (idx < 0 || cgraph->nodes[idx]->op != GGML_OP_CONV_2D_DW) {
+            return -1;
+        }
+        struct ggml_tensor * c = cgraph->nodes[idx];
+        if (c->src[1] == NULL || ggml_view_root(c->src[1]) != node || c->src[1]->data != node->data ||
+            !ggml_cpu_result_is_private(cgraph, node, idx)) {
+            return -1;
+        }
+        pad  = node;
+        node = c;
+    }
+
+    if (node->op != GGML_OP_CONV_2D_DW) {
+        return -1;
+    }
+    struct ggml_tensor * conv = node;
+    const struct ggml_tensor * csrc = conv->src[1];
+    if (conv->type != GGML_TYPE_F32 || !ggml_is_contiguous(conv) || (conv->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+        csrc == NULL || csrc->type != GGML_TYPE_F32 || !ggml_is_contiguous(csrc) ||
+        conv->ne[1] != 1 || csrc->ne[1] != 1 || conv->ne[3] != 1 ||
+        (conv->src[0]->type != GGML_TYPE_F32 && conv->src[0]->type != GGML_TYPE_F16)) {
+        return -1;
+    }
+
+    struct ggml_tensor * out = conv;
+    const struct ggml_tensor * bias = NULL;
+    bool relu = false;
+    int last = idx;
+
+    const int bias_idx = ggml_cpu_next_compute_node(cgraph, last + 1);
+    if (bias_idx >= 0 && cgraph->nodes[bias_idx]->op == GGML_OP_ADD) {
+        struct ggml_tensor * add = cgraph->nodes[bias_idx];
+        const struct ggml_tensor * b = ggml_cpu_conv_2d_add_operand(add, out, conv, true);
+        if (b && ggml_cpu_result_is_private(cgraph, out, bias_idx)) {
+            bias = b;
+            out  = add;
+            last = bias_idx;
+        }
+    }
+    const int relu_idx = ggml_cpu_next_compute_node(cgraph, last + 1);
+    if (relu_idx >= 0 && cgraph->nodes[relu_idx]->op == GGML_OP_UNARY &&
+        ggml_get_unary_op(cgraph->nodes[relu_idx]) == GGML_UNARY_OP_RELU) {
+        struct ggml_tensor * r = cgraph->nodes[relu_idx];
+        if (r->src[0] && ggml_view_root(r->src[0]) == out && r->src[0]->data == out->data &&
+            r->type == GGML_TYPE_F32 && ggml_is_contiguous(r) && ggml_is_contiguous(r->src[0]) &&
+            ggml_nelements(r) == ggml_nelements(conv) && ggml_cpu_result_is_private(cgraph, out, relu_idx)) {
+            relu = true;
+            out  = r;
+            last = relu_idx;
+        }
+    }
+
+    if (pad == NULL && out == conv) {
+        return -1;                                // nothing to fuse
+    }
+
+    // The kernel copies a source row out before writing over it, so the result may be EXACTLY the
+    // source; a partial overlap, or any overlap with the weights or the bias, it cannot handle.
+    const struct ggml_tensor * in = pad ? pad->src[0] : csrc;
+    const bool out_is_in = out->data == in->data && ggml_nbytes(out) == ggml_nbytes(in);
+    if ((!out_is_in && ggml_cpu_tensors_overlap(out, in)) ||
+        ggml_cpu_tensors_overlap(out, conv->src[0]) ||
+        (bias && ggml_cpu_tensors_overlap(out, bias))) {
+        return -1;
+    }
+
+    *conv_out = conv;
+    *pad_out  = pad;
+    *bias_out = bias;
+    *relu_out = relu;
+    *out_out  = out;
+    return last;
+}
