@@ -0,0 +1,431 @@
+// CPU_NEON_I8: a dynamic int8 mul_mat for AArch64 cores without the dot-product instructions (the
+// Cortex-A72 of a Raspberry Pi 4), on Q8_0 weights whose 32-element blocks all carry their row's scale.
+// loom P4.37; the weight format is loom's Q8_0_PC (ADR-076), which every other backend reads as ordinary
+// Q8_0.
+//
+// Why: tinyBLAS's Q8_0 GEMM needs DOTPROD, so on such a core a Q8_0 weight runs ggml's one-row
+// vec_dot_q8_0_q8_0. whisper-small's encoder linears took as long at Q8_0 as at F32 on a Pi 4 (fc1 3435
+// against 3302 ms), where onnxruntime's int8 runs 2.3x its own FP32.
+//
+// The GEMM is XNNPACK's `qd8-f32-qc8w-gemm 2x8c2s4__neon_mlal`, the kernel XNNPACK's own config picks for a
+// NEON core with no DOTPROD that is not an A53/A55. An 8-column panel holds, per 8 k, four steps of 2 k for
+// each column (c2), the steps' k pairs rotated by column (s4), so the activation register is rotated by
+// one pair (`ext`) between steps instead of being re-broadcast. SMULL + SMLAL take two 8-k groups into one
+// int16 lane, SADALP adds lane pairs into int32. Two int16 products cannot overflow: activations are in
+// [-127, 127] and weights in [-128, 127] (|2 x 127 x 128| < 2^15).
+//
+// One departure from XNNPACK, measured: the activations are quantized per 32 k, symmetric, as ggml's own
+// Q8_0 path quantizes them, not per row with a zero point. Each block's int32 sum is scaled into a float
+// accumulator (FMA) before the next. On whisper-small's encoder output against the F32 card (Pi 4, jfk):
+//
+//     activations quantized          error (Frobenius)   fc1 at four threads, against ggml's Q8_0 path
+//     per row, asymmetric (XNNPACK)  9.8e-2              2.58x
+//     per 256 k, symmetric           7.7e-2              2.52x
+//     per 64 k                       5.2e-2              2.39x
+//     per 32 k                       4.8e-2              2.23x       <- this
+//     ggml's Q8_0 path               4.8e-2              1
+//
+// The per-row error is not noise: scaling the input by (1 + 1e-7) moves that path's output 3.4e-2 and ggml's
+// 8.9e-3. Outlier channels set a whole row's range, and a card gated on ggml's Q8_0 numerics would change on
+// this core only. Per 32 k it keeps the card's error and 86% of the per-row speed.
+//
+// Copyright 2021 Google LLC (XNNPACK). Redistribution and use in source and binary forms, with or without
+// modification, are permitted under the BSD 3-clause license in XNNPACK's LICENSE file; the kernel below
+// is a re-templated copy of the generated `qd8-f32-qc8w-gemm-2x8c2s4-minmax-neon-mlal.c` (its inner loop
+// and weight layout), with the activation scaling described above in place of its zero point.
+
+#define GGML_COMMON_DECL_CPP
+#include "ggml-common.h"
+
+#include "neon-i8.h"
+
+#include "ggml-backend-impl.h"
+#include "ggml-cpu.h"
+#include "ggml-cpu-impl.h"
+#include "ggml-impl.h"
+#include "simd-mappings.h"
+#include "traits.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
