+#if defined(__aarch64__) && defined(__ARM_NEON)
+
+#include <arm_neon.h>
+
+namespace {
+
+constexpr int64_t NR = 8;
+
+// A panel: K / 8 groups of 64 B of weights, then the 8 columns' float scales.
+size_t panel_bytes(int64_t K) { return (size_t) K * NR + (size_t) NR * 4; }
+
+int64_t n_panels(const ggml_tensor * t) { return (t->ne[1] + NR - 1) / NR; }
+
+size_t packed_size(const ggml_tensor * t) { return (size_t) n_panels(t) * panel_bytes(t->ne[0]); }
+
+constexpr int64_t QK = 32;   // activation block
+
+// One row to int8, per 32 k: the block's absmax onto 127, rounded to nearest even; sb[K / 32] the scales.
+// A NaN in a block makes its absmax NaN (FMAX propagates it), so its scale is NaN and every output of the
+// row is; an inf makes the scale inf and the outputs inf or NaN.
+void quantize_row(const float * x, int64_t K, int8_t * q, float * sb) {
+    for (int64_t k0 = 0; k0 < K; k0 += QK) {
+        float32x4_t m0 = vabsq_f32(vld1q_f32(x + k0)), m1 = vabsq_f32(vld1q_f32(x + k0 + 4));
+        for (int64_t k = k0 + 8; k < k0 + QK; k += 8) {
+            m0 = vmaxq_f32(m0, vabsq_f32(vld1q_f32(x + k)));
+            m1 = vmaxq_f32(m1, vabsq_f32(vld1q_f32(x + k + 4)));
+        }
+        const float amax = vmaxvq_f32(vmaxq_f32(m0, m1));
+        sb[k0 / QK] = amax / 127.0f;
+        const float32x4_t vmul = vdupq_n_f32(amax > 0.0f ? 127.0f / amax : 0.0f);
+        for (int64_t k = k0; k < k0 + QK; k += 16) {
+            const int32x4_t i0 = vcvtnq_s32_f32(vmulq_f32(vld1q_f32(x + k), vmul));
+            const int32x4_t i1 = vcvtnq_s32_f32(vmulq_f32(vld1q_f32(x + k + 4), vmul));
+            const int32x4_t i2 = vcvtnq_s32_f32(vmulq_f32(vld1q_f32(x + k + 8), vmul));
+            const int32x4_t i3 = vcvtnq_s32_f32(vmulq_f32(vld1q_f32(x + k + 12), vmul));
+            const int16x8_t h0 = vcombine_s16(vqmovn_s32(i0), vqmovn_s32(i1));
+            const int16x8_t h1 = vcombine_s16(vqmovn_s32(i2), vqmovn_s32(i3));
+            vst1q_s8(q + k, vcombine_s8(vqmovn_s16(h0), vqmovn_s16(h1)));
+        }
+    }
+}
+
+// MR rows (a[r], K int8 each, sb[r] their block scales) against the panels from `w` on, nc columns, into
+// c[r][0..nc).
+template <int MR>
+void gemm_panels(int64_t K, const int8_t * const * a, const float * const * sb, const uint8_t * w, int64_t nc,
+                 float * const * c) {
+    float * cr[MR];
+    for (int r = 0; r < MR; ++r) {
+        cr[r] = c[r];
+    }
+    while (nc > 0) {
+        float32x4_t f[MR][2];
+        for (int r = 0; r < MR; ++r) {
+            f[r][0] = f[r][1] = vdupq_n_f32(0.0f);
+        }
+        const int8_t * wb = (const int8_t *) w;
+        for (int64_t k0 = 0; k0 < K; k0 += QK) {
+            int32x4_t acc[MR][2];
+            for (int r = 0; r < MR; ++r) {
+                acc[r][0] = acc[r][1] = vdupq_n_s32(0);
+            }
+            for (int64_t k = k0; k < k0 + QK; k += 16) {
+                int8x8_t x0[MR], x1[MR];
+                for (int r = 0; r < MR; ++r) {
+                    x0[r] = vld1_s8(a[r] + k);
+                    x1[r] = vld1_s8(a[r] + k + 8);
+                }
+                for (int s = 0; s < 4; ++s) {
+                    for (int h = 0; h < 2; ++h) {
+                        const int8x8_t b0 = vld1_s8(wb + 16 * s + 8 * h);
+                        const int8x8_t b1 = vld1_s8(wb + 64 + 16 * s + 8 * h);
+                        for (int r = 0; r < MR; ++r) {
+                            int16x8_t p = vmull_s8(b0, x0[r]);
+                            p           = vmlal_s8(p, b1, x1[r]);
+                            acc[r][h]   = vpadalq_s16(acc[r][h], p);
+                        }
+                    }
+                    if (s < 3) {
+                        for (int r = 0; r < MR; ++r) {
+                            x0[r] = vext_s8(x0[r], x0[r], 2);
+                            x1[r] = vext_s8(x1[r], x1[r], 2);
+                        }
+                    }
+                }
+                wb += 128;
+            }
+            for (int r = 0; r < MR; ++r) {
+                const float s = sb[r][k0 / QK];
+                f[r][0] = vfmaq_n_f32(f[r][0], vcvtq_f32_s32(acc[r][0]), s);
+                f[r][1] = vfmaq_n_f32(f[r][1], vcvtq_f32_s32(acc[r][1]), s);
+            }
+        }
+        const float32x4_t ws0 = vld1q_f32((const float *) wb), ws1 = vld1q_f32((const float *) wb + 4);
+        w = (const uint8_t *) (wb + NR * 4);
+        for (int r = 0; r < MR; ++r) {
+            const float32x4_t o0 = vmulq_f32(f[r][0], ws0);
+            const float32x4_t o1 = vmulq_f32(f[r][1], ws1);
+            if (nc >= NR) {
+                vst1q_f32(cr[r], o0);
+                vst1q_f32(cr[r] + 4, o1);
+            } else {
+                float t[NR];
+                vst1q_f32(t, o0);
+                vst1q_f32(t + 4, o1);
+                memcpy(cr[r], t, (size_t) nc * sizeof(float));
+            }
+            cr[r] += NR;
+        }
+        nc -= NR;
+    }
+}
+
+class tensor_traits : public ggml::cpu::tensor_traits {
+    // Rows of src1 in (i11, i12, i13) order; the work buffer holds their int8 copies, then their block scales.
+    static int64_t n_rows(const ggml_tensor * op) { return op->src[1]->ne[1] * op->src[1]->ne[2] * op->src[1]->ne[3]; }
+
+    bool work_size(int /*n_threads*/, const ggml_tensor * op, size_t & size) override {
+        if (op->op == GGML_OP_GET_ROWS) {
+            size = 0;
+            return true;
+        }
+        const int64_t K = op->src[0]->ne[0];
+        size = (size_t) n_rows(op) * (K + (K / QK) * sizeof(float)) + 64;
+        return true;
+    }
+
+    // A tied embedding is read by GET_ROWS as well as by the output projection's mul_mat. Without this the
+    // engine keeps a second, plain copy for the lookup: 165 MB for Qwen3-0.6B, 42 MB for whisper-small. A
+    // row comes out as q * d, the float product ggml's own Q8_0 dequantize computes, so the bytes match it.
+    static bool get_rows(const ggml_compute_params * params, ggml_tensor * op) {
+        const ggml_tensor * src0 = op->src[0];
+        const ggml_tensor * src1 = op->src[1];
+        const int64_t K = src0->ne[0], N = src0->ne[1];
+        const int64_t ne10 = src1->ne[0], ne11 = src1->ne[1];
+        const int64_t nr = ggml_nelements(src1);
+        const size_t pbytes = panel_bytes(K);
+        for (int64_t i = params->ith; i < nr; i += params->nth) {
+            const int64_t i10 = i % ne10, i11 = (i / ne10) % ne11, i12 = i / (ne10 * ne11);
+            const int64_t n = *(const int32_t *) ((const char *) src1->data + i10 * src1->nb[0] + i11 * src1->nb[1] +
+                                                  i12 * src1->nb[2]);
+            GGML_ASSERT(n >= 0 && n < N);
+            float * y = (float *) ((char *) op->data + i10 * op->nb[1] + i11 * op->nb[2] + i12 * op->nb[3]);
+            const int8_t * w  = (const int8_t *) src0->data + (n / NR) * pbytes;
+            const int64_t  j  = n % NR;
+            const float    d  = ((const float *) (w + K * NR))[j];
+            const int8_t * wj = w + 8 * (j / 4) + 2 * (j % 4);
+            for (int64_t g = 0; g < K / 8; ++g) {
+                for (int64_t s = 0; s < 4; ++s) {
+                    const int64_t k = 8 * g + ((2 * s + 2 * j) & 7);
+                    y[k]     = wj[64 * g + 16 * s] * d;
+                    y[k + 1] = wj[64 * g + 16 * s + 1] * d;
+                }
+            }
+        }
+        return true;
+    }
+
+    bool compute_forward(ggml_compute_params * params, ggml_tensor * op) override {
+        if (op->op == GGML_OP_GET_ROWS) {
+            return get_rows(params, op);
+        }
+        if (op->op != GGML_OP_MUL_MAT) {
+            return false;
+        }
+        const ggml_tensor * src0 = op->src[0];
+        const ggml_tensor * src1 = op->src[1];
+        const int64_t K = src0->ne[0], N = src0->ne[1];
+        const int64_t M = n_rows(op);
+        const int64_t ne11 = src1->ne[1], ne12 = src1->ne[2];
+        const int ith = params->ith, nth = params->nth;
+
+        int8_t * qa = (int8_t *) GGML_PAD((uintptr_t) params->wdata, 64);
+        float *  sq = (float *) (qa + M * K);
+        auto src1_row = [&](int64_t m) {
+            const int64_t i11 = m % ne11, i12 = (m / ne11) % ne12, i13 = m / (ne11 * ne12);
+            return (const float *) ((const char *) src1->data + i11 * src1->nb[1] + i12 * src1->nb[2] + i13 * src1->nb[3]);
+        };
+        auto dst_row = [&](int64_t m) {
+            const int64_t i11 = m % ne11, i12 = (m / ne11) % ne12, i13 = m / (ne11 * ne12);
+            return (float *) ((char *) op->data + i11 * op->nb[1] + i12 * op->nb[2] + i13 * op->nb[3]);
+        };
+
+        for (int64_t m = ith * M / nth; m < (ith + 1) * M / nth; ++m) {
+            quantize_row(src1_row(m), K, qa + m * K, sq + m * (K / QK));
+        }
+        ggml_barrier(params->threadpool);
+
+        // Two schedules (bench65 on a Pi 4 at four threads, against ggml's Q8_0 path on the same weights; measured
+        // with the per-row activations of the experiment above, on the same inner loop):
+        //
+        //  * Few rows, whose int8 copies fit a quarter of the shared 1 MB L2: panels dealt round robin, so the
+        //    threads read adjacent panels and DRAM sees one stream. With contiguous ranges, four streams 600 KB
+        //    apart, a one-row K 3072 x N 768 product ran 0.90x; dealt, 1.09x. Dealt beat the blocked schedule
+        //    1.05-1.5x up to 64 rows, and broke even at 128-512.
+        //  * Many rows: each thread a contiguous range of panels (of row pairs, when there are fewer than four
+        //    panels a thread), walked in blocks of 160 KB of weights that stay in L2 while every row pair
+        //    streams past with its rows in L1. At 1500 rows, 2.47x against 2.16x dealt. 256 KB blocks lost at
+        //    four threads (four of them are the whole L2), and a 4-row tile was no faster than XNNPACK's 2.
+        const int64_t   P      = n_panels(src0);
+        const uint8_t * wp     = (const uint8_t *) src0->data;
+        const size_t    pbytes = panel_bytes(K);
+        auto run = [&](int64_t p0, int64_t p1, int64_t ma, int64_t mz) {
+            const int64_t   n0 = p0 * NR, nc = std::min(N, p1 * NR) - n0;
+            const uint8_t * w  = wp + p0 * pbytes;
+            int64_t         m  = ma;
+            for (; m + 2 <= mz; m += 2) {
+                const int8_t * a[2] = { qa + m * K, qa + (m + 1) * K };
+                const float *  s[2] = { sq + m * (K / QK), sq + (m + 1) * (K / QK) };
+                float *        c[2] = { dst_row(m) + n0, dst_row(m + 1) + n0 };
+                gemm_panels<2>(K, a, s, w, nc, c);
+            }
+            if (m < mz) {
+                const int8_t * a[1] = { qa + m * K };
+                const float *  s[1] = { sq + m * (K / QK) };
+                float *        c[1] = { dst_row(m) + n0 };
+                gemm_panels<1>(K, a, s, w, nc, c);
+            }
+        };
+        if (M * K <= 256 * 1024) {
+            for (int64_t p = ith; p < P; p += nth) {
+                run(p, p + 1, 0, M);
+            }
+            return true;
+        }
+        int64_t pa = 0, pz = P, ma = 0, mz = M;
+        if (P >= 4 * nth) {
+            pa = ith * P / nth;
+            pz = (ith + 1) * P / nth;
+        } else {
+            const int64_t pairs = (M + 1) / 2;
+            ma = std::min(M, ith * pairs / nth * 2);
+            mz = std::min(M, (ith + 1) * pairs / nth * 2);
+        }
+        const int64_t pb = std::max<int64_t>(1, 160 * 1024 / (int64_t) pbytes);
+        for (int64_t p0 = pa; p0 < pz; p0 += pb) {
+            run(p0, std::min(pz, p0 + pb), ma, mz);
+        }
+        return true;
+    }
+
+  public:
+    static tensor_traits * get() {
+        static tensor_traits t;
+        return &t;
+    }
+};
+
+bool is_candidate(const ggml_tensor * t) {
+    // K % 32 == 0 is Q8_0's own, and the activation block's.
+    return t->type == GGML_TYPE_Q8_0 && ggml_n_dims(t) == 2 && t->ne[0] % 32 == 0;
+}
+
+enum ggml_status buffer_init_tensor(ggml_backend_buffer_t, ggml_tensor * tensor) {
+    tensor->extra = is_candidate(tensor) ? (void *) tensor_traits::get() : nullptr;
+    return GGML_STATUS_SUCCESS;
+}
+
+void buffer_set_tensor(ggml_backend_buffer_t, ggml_tensor * tensor, const void * data, size_t offset, size_t size) {
+    GGML_ASSERT(offset == 0);
+    GGML_ASSERT(size == ggml_nbytes(tensor));
+    if (tensor->extra == nullptr) {
+        memcpy(tensor->data, data, size);
+        return;
+    }
+    const int64_t K = tensor->ne[0], N = tensor->ne[1], nb = K / 32;
+    const block_q8_0 * src = (const block_q8_0 *) data;
+    for (int64_t n = 0; n < N; ++n) {
+        for (int64_t b = 1; b < nb; ++b) {
+            if (src[n * nb + b].d != src[n * nb].d) {
+                GGML_LOG_WARN("%s: %s: row %lld's blocks have different scales, so it is not per-channel int8; "
+                              "ggml's Q8_0 mul_mat runs it\n", __func__, tensor->name, (long long) n);
+                memcpy(tensor->data, data, size);
+                tensor->extra = nullptr;
+                return;
+            }
+        }
+    }
+    const size_t pbytes = panel_bytes(K);
+    for (int64_t p = 0; p < n_panels(tensor); ++p) {
+        uint8_t * base = (uint8_t *) tensor->data + p * pbytes;
+        int8_t *  w    = (int8_t *) base;
+        float *   ws   = (float *) (base + K * NR);
+        for (int64_t g = 0; g < K / 8; ++g) {
+            for (int64_t s = 0; s < 4; ++s) {
+                for (int64_t j = 0; j < NR; ++j) {
+                    const int64_t n = p * NR + j, k = 8 * g + ((2 * s + 2 * j) & 7);
+                    w[0] = n < N ? src[n * nb + k / 32].qs[k % 32] : 0;
+                    w[1] = n < N ? src[n * nb + k / 32].qs[k % 32 + 1] : 0;
+                    w += 2;
+                }
+            }
+        }
+        for (int64_t j = 0; j < NR; ++j) {
+            const int64_t n = p * NR + j;
+            ws[j] = n < N ? GGML_CPU_FP16_TO_FP32(src[n * nb].d) : 0.0f;
+        }
+    }
+}
+
+const char * buft_get_name(ggml_backend_buffer_type_t) { return "CPU_NEON_I8"; }
+
+ggml_backend_buffer_t buft_alloc_buffer(ggml_backend_buffer_type_t buft, size_t size) {
+    ggml_backend_buffer_t buffer = ggml_backend_buft_alloc_buffer(ggml_backend_cpu_buffer_type(), size);
+    if (buffer == nullptr) {
+        return nullptr;
+    }
+    buffer->buft              = buft;
+    buffer->iface.init_tensor = buffer_init_tensor;
+    buffer->iface.set_tensor  = buffer_set_tensor;
+    buffer->iface.get_tensor  = nullptr;
+    buffer->iface.cpy_tensor  = nullptr;
+    return buffer;
+}
+
+size_t buft_get_alignment(ggml_backend_buffer_type_t) { return 64; }
+
+size_t buft_get_alloc_size(ggml_backend_buffer_type_t, const ggml_tensor * tensor) {
+    const size_t n = ggml_nbytes(tensor);
+    return is_candidate(tensor) ? std::max(n, packed_size(tensor)) : n;
+}
+
+class extra_buffer_type : public ggml::cpu::extra_buffer_type {
+    bool supports_op(ggml_backend_dev_t, const ggml_tensor * op) override {
+        if (op->op == GGML_OP_GET_ROWS) {
+            return op->src[0]->buffer && op->src[0]->buffer->buft == ggml_backend_cpu_neon_i8_buffer_type() &&
+                   op->src[0]->extra != nullptr && op->src[1]->type == GGML_TYPE_I32 && op->type == GGML_TYPE_F32;
+        }
+        return op->op == GGML_OP_MUL_MAT && op->src[0]->buffer &&
+               op->src[0]->buffer->buft == ggml_backend_cpu_neon_i8_buffer_type() && is_candidate(op->src[0]) &&
+               op->src[0]->extra != nullptr && op->src[1]->type == GGML_TYPE_F32 && op->type == GGML_TYPE_F32 &&
+               op->src[1]->nb[0] == sizeof(float) &&
+               (op->src[1]->buffer == nullptr || ggml_backend_buft_is_host(op->src[1]->buffer->buft));
+    }
+
+    ggml::cpu::tensor_traits * get_tensor_traits(const ggml_tensor * op) override {
+        if ((op->op == GGML_OP_MUL_MAT || op->op == GGML_OP_GET_ROWS) && op->src[0]->buffer &&
+            op->src[0]->buffer->buft == ggml_backend_cpu_neon_i8_buffer_type()) {
+            return (ggml::cpu::tensor_traits *) op->src[0]->extra;
+        }
+        return nullptr;
+    }
+};
+
+}  // namespace
+
+ggml_backend_buffer_type_t ggml_backend_cpu_neon_i8_buffer_type(void) {
+    // Only where it was measured: a core without DOTPROD, where tinyBLAS has no Q8_0 kernel. On a DOTPROD
+    // core tinyBLAS's own Q8_0 GEMM and CPU_REPACK are the incumbents, and this kernel was not raced there.
+    static const bool enabled = [] {
+        const char * e = getenv("GGML_CPU_NEON_I8");
+        return !(e && e[0] == '0') && !ggml_cpu_has_dotprod();
+    }();
+    static struct ggml_backend_buffer_type buft = {
+        /* .iface    = */ {
+                           /* .get_name             = */ buft_get_name,
+                           /* .alloc_buffer         = */ buft_alloc_buffer,
+                           /* .alloc_buffer_n       = */ nullptr,
+                           /* .get_alignment        = */ buft_get_alignment,
+                           /* .get_max_size         = */ nullptr,
+                           /* .get_alloc_size       = */ buft_get_alloc_size,
+                           /* .get_alloc_size_n     = */ nullptr,
+                           /* .is_host              = */ nullptr,
+                           },
+        /* .device  = */ ggml_backend_reg_dev_get(ggml_backend_cpu_reg(), 0),
+        /* .context = */ new extra_buffer_type(),
+    };
+    return enabled ? &buft : nullptr;
+}
+
+#else
+
+ggml_backend_buffer_type_t ggml_backend_cpu_neon_i8_buffer_type(void) {
+    return nullptr;
+}
