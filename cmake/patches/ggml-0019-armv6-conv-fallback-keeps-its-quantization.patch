+// whole number of Q8_0 blocks, a work buffer too small for the quantized patches, or the kill switch.
+static bool ggml_conv_2d_armv6_qgemm(const ggml_compute_params * params, const void * qk,
+                                     void * tmp, int64_t patches_per_batch, int64_t patch_n,
+                                     int64_t c_out, int64_t knl_n, float * out, int64_t ldc) {
+#if defined(GGML_USE_LLAMAFILE) && defined(__ARM_FEATURE_SIMD32) && !defined(__ARM_NEON) && !defined(__aarch64__)
+    const int64_t blck = ggml_blck_size(GGML_TYPE_Q8_0);   // == ggml_blck_size(Q4_0) == 32
+    if (qk == NULL || (knl_n % blck) != 0) {
+        return false;
+    }
+    // OFF BY DEFAULT, AND THE DEFAULT IS THE FINDING. Measured on a Pi Zero W with this route on:
+    //
+    //   * VITS (every convolution 1-D, kh == 1): bit-identical output, 246.9 s against 253.2 s --
+    //     2.6%, not the 1.42x the shape-level benchmark projected. Most of the vocoder's declined
+    //     convolutions do not reach this call site.
+    //   * conformer-ctc: WRONG. Its only quantized convolutions are the 2-D subsampling stem, and
+    //     the transcript comes back as "i" instead of the sentence. Something in the kh > 1 case is
+    //     not what this assumes, and it has not been found yet.
+    //
+    // So it stays behind an opt-in until the 2-D case is understood: 2.6% on one model is not worth
+    // a silent wrong answer on another. The GEMM itself (llamafile/sgemm.cpp) is unaffected and is
+    // on by default -- it is verified bit-identical and is worth 1.62x on distilbert-ner.
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char * e = getenv("GGML_CPU_ENABLE_ARMV6_CONV_QGEMM");
+        enabled = (e && e[0] && e[0] != '0') ? 1 : 0;
+    }
+    if (!enabled) {
+        return false;
+    }
+
+    // Staged where the F32 path would have put `gemm_output`, which this branch does not use because
+    // it writes straight into dst. Checked against the buffer's real end rather than assumed: a
+    // convolution with a long contraction and few output channels would not fit, and must fall back.
+    const size_t q8row = ggml_row_size(GGML_TYPE_Q8_0, knl_n);
+    char * const   qb  = (char *) tmp + (size_t) patches_per_batch * knl_n * sizeof(float);
+    const char * const wend = (const char *) params->wdata + params->wsize;
+    if (qb + (size_t) patch_n * q8row > wend) {
+        return false;
+    }
