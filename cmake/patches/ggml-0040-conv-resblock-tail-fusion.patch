+// ggml-0040: a HiFi-GAN stage's TAIL after a resblock's last convolution (with its bias and residual
+// already fused): the stage sums its resblocks and scales the sum before the next upsampling,
+//
+//     s  = ADD(r0, r1);  s = ADD(s, r2)       two full passes, one per resblock after the first
+//     m  = MUL(s, 1/3)                        a full pass
+//     h  = LEAKY_RELU(m)                      a full pass -- the next transposed convolution's input
+//
+// so the convolution that produces r1 can also add r0, and the one that produces r2 can add the running
+// sum, scale it and apply the activation, each node's own arithmetic in its order. Each part is
+// optional after the one before; each node must be the only reader of the one before it.
+static void ggml_cpu_conv_tail_match(const struct ggml_cgraph * cgraph, const struct ggml_tensor * conv,
+                                     struct ggml_conv_2d_fusion * f, int * last) {
+    const int add_idx = ggml_cpu_next_compute_node(cgraph, *last + 1);
+    if (add_idx < 0 || cgraph->nodes[add_idx]->op != GGML_OP_ADD) {
+        return;
+    }
+    struct ggml_tensor * add = cgraph->nodes[add_idx];
+    const struct ggml_tensor * other = ggml_cpu_conv_2d_add_operand(add, f->out, conv, false);
+    if (other == NULL || !ggml_cpu_result_is_private(cgraph, f->out, add_idx)) {
+        return;
+    }
+    f->add2 = other;
+    f->out  = add;
+    *last   = add_idx;
+
+    const int mul_idx = ggml_cpu_next_compute_node(cgraph, *last + 1);
+    if (mul_idx >= 0 && cgraph->nodes[mul_idx]->op == GGML_OP_MUL) {
+        struct ggml_tensor * mul = cgraph->nodes[mul_idx];
+        const struct ggml_tensor * x = NULL, * s = NULL;
+        for (int k = 0; k < 2; ++k) {
+            if (mul->src[k] && ggml_view_root(mul->src[k]) == f->out && mul->src[k]->data == f->out->data) {
+                x = mul->src[k];
+                s = mul->src[1 - k];
+            }
+        }
+        if (x && s && s->type == GGML_TYPE_F32 && ggml_nelements(s) == 1 && mul->type == GGML_TYPE_F32 &&
+            ggml_is_contiguous(mul) && ggml_is_contiguous(x) && ggml_nelements(mul) == ggml_nelements(conv) &&
+            ggml_are_same_shape(x, mul) && ggml_cpu_result_is_private(cgraph, f->out, mul_idx)) {
+            f->scale = s;
+            f->out   = mul;
+            *last    = mul_idx;
+        }
+    }
+
+    const int lk_idx = ggml_cpu_next_compute_node(cgraph, *last + 1);
+    if (lk_idx >= 0 && cgraph->nodes[lk_idx]->op == GGML_OP_LEAKY_RELU) {
+        struct ggml_tensor * lk = cgraph->nodes[lk_idx];
+        if (lk->src[0] && ggml_view_root(lk->src[0]) == f->out && lk->src[0]->data == f->out->data &&
+            lk->type == GGML_TYPE_F32 && ggml_is_contiguous(lk) && ggml_is_contiguous(lk->src[0]) &&
+            ggml_nelements(lk) == ggml_nelements(conv) && ggml_cpu_result_is_private(cgraph, f->out, lk_idx)) {
+            f->leaky = lk;
+            f->out   = lk;
+            *last    = lk_idx;
+        }
+    }
+}
