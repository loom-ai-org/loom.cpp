+        }
     }
 
     if (f->act == NULL && f->out == conv) {
@@ -3494,6 +3557,19 @@ static int ggml_cpu_conv_2d_fusion(const struct ggml_cgraph * cgraph, int node_n
     if (out != conv && out->data != conv->data && ggml_cpu_tensors_overlap(out, conv)) {
         return -1;
     }
+    // ggml-0040: the tail's tensor operand reads like the residual -- for an element just before the
+    // element is stored -- so it may BE the result, and must otherwise stay clear of everything written
+    if (f->add2) {
+        const bool add2_is_out = f->add2->data == out->data && ggml_nbytes(f->add2) == ggml_nbytes(out);
+        if ((!add2_is_out && ggml_cpu_tensors_overlap(f->add2, out)) ||
+            ggml_cpu_tensors_overlap(f->add2, conv) || ggml_cpu_tensors_overlap(f->add2, conv->src[0]) ||
+            (f->bias && ggml_cpu_tensors_overlap(f->add2, f->bias))) {
+            return -1;
+        }
+    }
+    if (f->scale && (ggml_cpu_tensors_overlap(f->scale, out) || ggml_cpu_tensors_overlap(f->scale, conv))) {
+        return -1;
+    }
     if (f->residual) {
         const bool res_is_out = f->residual->data == out->data &&
                                 ggml_nbytes(f->residual) == ggml_nbytes(out);
@@ -3655,7 +3731,7 @@ static int ggml_cpu_try_fuse_ops(
         const int last = ggml_cpu_conv_2d_fusion(cgraph, node_n, &f);
         if (last > node_n) {
             ggml_compute_forward_conv_2d_fused(params, f.conv, f.act, f.bias, f.residual, f.relu, f.mask,
-                                               f.via_conv, f.out);
+                                               f.via_conv, f.out, f.add2, f.scale, f.leaky);
             return last - node_n;   // the nodes covered, and any views of the result between them
         }
     }
