+// ---------------------------------------------------------------------------------------------
+// ARMv6 ONLY: THE 1-D CONVOLUTIONS ON THE VFP11'S SHORT VECTORS (loom ADR-079, item P4.32b).
+//
+// An ARM1176 has no SIMD unit for floats, but its VFP runs short vectors: with FPSCR LEN = 4 one vmla
+// is four MACs against a scalar, and the ceiling is 0.94 GMAC/s against 0.49-0.69 for scalar vmla in
+// RunFast (loom scripts/bench44.c). The kernels are generated asm (loom scripts/gen_armv6_conv_f32.py,
+// into arch/arm/armv6-conv-f32.inc): 4 output channels x 4 time steps per tile, taps unrolled per
+// kernel width, the dilation an argument. They hold LEN = 4 only inside the generated function, whose
+// region is integer loops and VFP code; nothing compiled ever runs with it set. Linux clears LEN for a
+// signal handler and restores FPSCR on sigreturn and across switches; loom's
+// scripts/armv6_shortvec_gate.c checked that on the board (ADR-079 gate 1).
+//
+// What runs here per block of TB output positions and chunk of input channels: the chunk's window rows
+// [icc][TB + (k-1)d] are copied out of the activation (zero padding and a fused LEAKY_RELU applied on
+// the way, plain C, LEN = 0), then for each quad of output channels the kernel sweeps the block's tiles,
+// the window and the quad's weights for the chunk staying in L1 across them. The weights are packed [OC/4][IC][k][4] once per call, a partial last quad padded with
+// zero channels. The window is the only place the activation is read, so a block's result may be
+// written over input that later blocks no longer need -- see `defer` below.
+//
+// Measured on a Pi Zero W (loom scripts/bench49.cpp, the vocoders' shapes, one thread, RunFast): the
+// tile at TB = 64 runs 1.10-1.11 GOP/s, against 0.25-0.65 in ggml's direct sweep and im2col GEMMs.
+//
+// GGML_CPU_ARMV6_CONV=0 turns the path off (the A/B switch); _TB=<n> and _L1=<bytes> fix the blocking.
+#if defined(__ARM_FEATURE_SIMD32) && !defined(__ARM_NEON) && !defined(__aarch64__)
+#include "arch/arm/armv6-conv-f32.inc"
+
+static int ggml_armv6_conv_env(const char * name, int dflt) {
+    const char * e = getenv(name);
+    return (e && e[0]) ? atoi(e) : dflt;
+}
+
+// Returns false, having touched nothing, for a convolution it does not take; the caller's paths run.
+static bool ggml_conv_1d_armv6(const ggml_compute_params * params, const ggml_tensor * kernel,
+                               const ggml_tensor * src, ggml_tensor * dst, const float * bias_data,
+                               float * out_data, const float * src_data, const float * leaky,
+                               const float * res_data) {
+    static const int enabled = ggml_armv6_conv_env("GGML_CPU_ARMV6_CONV", 1);
+    static const int tb_env  = ggml_armv6_conv_env("GGML_CPU_ARMV6_CONV_TB", 0);
+    static const int l1_env  = ggml_armv6_conv_env("GGML_CPU_ARMV6_CONV_L1", 12 * 1024);
+    if (!enabled) return false;
+    if (kernel->type != GGML_TYPE_F32 || src->type != GGML_TYPE_F32) return false;
+    if (kernel->ne[1] != 1 || src->ne[1] != 1 || dst->ne[1] != 1) return false;   // 1-D only
+    if (dst->ne[3] != 1 || src->ne[3] != 1) return false;
+    if (dst->op_params[0] != 1) return false;                                      // stride 1
+    if (!ggml_is_contiguous(src) || !ggml_is_contiguous(kernel) || !ggml_is_contiguous(dst)) return false;
+
+    const int64_t IC = src->ne[2], OC = dst->ne[2], KW = kernel->ne[0];
+    const int64_t IL = src->ne[0], OL = dst->ne[0];
+    const int64_t dil = dst->op_params[4], pad = dst->op_params[2];
+    // KW = 1 is a GEMM and stays with the GEMM path (ADR-079 P4.32d) until that one is measured.
+    if (KW < 2 || KW > GGML_ARMV6_CONV_KMAX || OL < 4 || dil < 1) return false;
+    const int64_t span = (KW - 1) * dil;
+    if (dil * 4 > INT32_MAX / 2 || OL * 4 > INT32_MAX / 2) return false;
+
+    float *       y = out_data ? out_data : (float *) dst->data;
+    const float * x = src_data;
+
+    // Where the result may not go straight from the kernel to `y`: a fused residual is added on the
+    // way out, a partial last quad has rows that do not exist, and an output that overlaps the input
+    // must wait until the next block's window has been copied. Those stage each block through a
+    // scratch [OCq*4][TB] and flush it.
+    const char * ylo = (const char *) y, * yhi = (const char *) (y + OC * OL);
+    const char * xlo = (const char *) x, * xhi = (const char *) (x + IC * IL);
+    const bool aliases = ylo < xhi && xlo < yhi;
+    if (aliases && !(y == x && IC == OC && IL == OL && params->nth == 1)) return false;
+    if (res_data) {
+        const char * rlo = (const char *) res_data, * rhi = (const char *) (res_data + OC * OL);
+        if (res_data != y && rlo < yhi && ylo < rhi) return false;
+    }
+    const bool stage = aliases || res_data || (OC % 4) != 0;
+
+    // THE BLOCKING: TB output steps per block, and the input channels in chunks of `icc`, sized so one
+    // chunk's window rows and one quad's weights for them fit `l1` bytes together. The L1 is 16 KB, and
+    // the first version, which held the whole window [IC][TB + (k-1)d] at once and only shortened TB for
+    // wide inputs, ran the dilated half of every resblock at half rate on the board: amy 48ch k7 at
+    // 0.53 GOP/s against 0.89 for its d = 1 twin, VITS 64ch k7 at 0.40 against 0.80, a 384-channel
+    // stage at 0.55, where the window and the quad's weights came to 20-55 KB. Chunk 0 starts the
+    // accumulators from the bias; each later chunk continues from the partial sums in the output tile.
+    // Swept on the board over the models' slow shapes (loom scripts/bench50.cpp `model`), total GOP/s:
+    // TB 64 / 96 / 128 / 192 / 256 = 1.12 / 1.15 / 1.16-1.17 / 1.15 / 1.12 (a longer block re-reads the
+    // weights less often, a shorter one keeps the chunk wider), and the L1 budget flat from 8 to 16 KB
+    // (1.11 / 1.12 / 1.11). GGML_CPU_ARMV6_CONV_TB and GGML_CPU_ARMV6_CONV_L1 fix the two.
+    int64_t TB = tb_env > 0 ? tb_env : 128;
+    TB = (TB + 3) & ~(int64_t) 3;
+    if (aliases && TB < pad) return false;         // `defer` needs a block to outreach the padding
+    const int64_t TBx  = TB + 4;                   // a block absorbs a remainder shorter than a tile
+    const int64_t xrow = TBx + span;               // floats per window row
+    const int64_t row_bytes = xrow * 4 + KW * 16;  // one channel's window row + its weights in a quad
+    const int64_t icc_max = MAX((int64_t) 1, (int64_t) l1_env / row_bytes - 1);
+    const int64_t nch  = (IC + icc_max - 1) / icc_max;
+    const int64_t icc  = (IC + nch - 1) / nch;
+
+    const int64_t OCq  = (OC + 3) / 4;
+    const size_t  n_wp = (size_t) OCq * IC * KW * 4 + 4;   // + the tile's W preload past the last quad
+    const size_t  n_b  = (size_t) OCq * 4;
+    const size_t  n_x  = (size_t) (icc + 1) * xrow + 4;    // + the spare row the last preload reads
+    const size_t  n_y  = 2 * (size_t) OCq * 4 * TBx;
+    const size_t  need = (GGML_PAD(n_wp * 4, 64) + GGML_PAD(n_b * 4, 64)) +
+                         (size_t) params->nth * GGML_PAD((n_x + n_y) * 4, 64);
+    if (need > params->wsize) return false;
+
+    char *  wdata = (char *) params->wdata;
+    float * wp = (float *) wdata;
+    float * bz = (float *) (wdata + GGML_PAD(n_wp * 4, 64));
+    char *  mine = wdata + GGML_PAD(n_wp * 4, 64) + GGML_PAD(n_b * 4, 64) +
+                   (size_t) params->ith * GGML_PAD((n_x + n_y) * 4, 64);
+    float * xw = (float *) mine;
+    float * ys = xw + n_x;
+
+    const float * w = (const float *) kernel->data;
+    for (int64_t q = params->ith; q < OCq; q += params->nth) {
+        float * d = wp + (size_t) q * IC * KW * 4;
+        for (int64_t c = 0; c < IC; ++c)
+            for (int64_t j = 0; j < KW; ++j)
+                for (int64_t r = 0; r < 4; ++r) {
+                    const int64_t o = 4 * q + r;
+                    *d++ = o < OC ? w[(o * IC + c) * KW + j] : 0.0f;
+                }
+    }
+    if (params->ith == 0) {
+        for (int64_t o = 0; o < (int64_t) n_b; ++o) bz[o] = (bias_data && o < OC) ? bias_data[o] : 0.0f;
+        for (int i = 0; i < 4; ++i) wp[n_wp - 4 + i] = 0.0f;
+    }
+    ggml_barrier(params->threadpool);
+
+    // Blocks of TB; the last absorbs a remainder shorter than a tile, so every block holds >= 4.
+    const int64_t nblk = OL < TB ? 1 : OL / TB + (OL % TB >= 4 ? 1 : 0);
+    const int64_t per  = (nblk + params->nth - 1) / params->nth;
+    const int64_t b0   = params->ith * per, b1 = MIN(b0 + per, nblk);
+    auto block_len = [&](int64_t b) { return b == nblk - 1 ? OL - b * TB : TB; };
+
+    int64_t pend = -1;                             // the staged block not yet flushed
+    float * ycur = ys, * yprev = ys + (size_t) OCq * 4 * TBx;
+    auto flush = [&](int64_t b, const float * yb) {
+        const int64_t t0 = b * TB, nb = block_len(b);
+        for (int64_t o = 0; o < OC; ++o) {
+            const float * s = yb + (size_t) o * TBx;
+            float *       d = y + o * OL + t0;
+            if (res_data) {
+                const float * r = res_data + o * OL + t0;
+                for (int64_t t = 0; t < nb; ++t) d[t] = s[t] + r[t];
+            } else {
+                memcpy(d, s, (size_t) nb * sizeof(float));
+            }
+        }
+    };
+
+    ggml_armv6_conv_args a;
+    a.xrow = (int32_t) (xrow * 4);
+    a.d4   = (int32_t) (dil * 4);
+    const ggml_armv6_conv_fn fn = ggml_armv6_conv_f32[KW];
+    for (int64_t b = b0; b < b1; ++b) {
+        const int64_t t0 = b * TB, nb = block_len(b);
+        // A ragged block runs whole tiles into the staging buffer and flushes only its nb steps: a
+        // recomputed overlapping tile would add a chunk's sum twice. The window is zero past the input.
+        const int64_t nt = (nb + 3) / 4, L = nt * 4 + span;
+        const bool    stage_b = stage || (nb % 4) != 0;
+        float *       yb   = stage_b ? ycur : y + t0;
+        const int32_t ystr = (int32_t) ((stage_b ? TBx : OL) * 4);
+        for (int64_t ch = 0; ch < nch; ++ch) {
+            const int64_t c0 = ch * icc, cn = MIN(icc, IC - c0);
+            for (int64_t c = 0; c < cn; ++c) {
+                float *       row = xw + (size_t) c * xrow;
+                const float * in  = x + (c0 + c) * IL;
+                const int64_t p0 = t0 - pad;             // input position of row[0]
+                const int64_t lo = MAX((int64_t) 0, -p0), hi = MIN(L, IL - p0);
+                if (lo > 0) memset(row, 0, (size_t) MIN(lo, L) * sizeof(float));
+                if (hi > lo) {
+                    if (leaky) ggml_conv1d_leaky_copy(row + lo, in + p0 + lo, hi - lo, *leaky);
+                    else       memcpy(row + lo, in + p0 + lo, (size_t) (hi - lo) * sizeof(float));
+                }
+                if (MAX(hi, lo) < L) memset(row + MAX(hi, lo), 0, (size_t) (L - MAX(hi, lo)) * sizeof(float));
+            }
+            // This block's input is all copied once the last chunk is: the block before may now be
+            // written, even over it.
+            if (ch == nch - 1 && pend >= 0) { flush(pend, yprev); pend = -1; }
+            a.n_ic = (int32_t) cn;
+            for (int64_t q = 0; q < OCq; ++q) {
+                a.w = wp + ((size_t) q * IC + c0) * KW * 4;
+                a.b = ch == 0 ? bz + 4 * q : nullptr;
+                a.ystride = ystr;
+                a.x = xw; a.y = yb + (size_t) 4 * q * (ystr / 4); a.nt = (int32_t) nt;
+                fn(&a);
+            }
+        }
+        if (stage_b) {
+            if (aliases) { pend = b; std::swap(ycur, yprev); }
+            else         flush(b, ycur);
+        }
+    }
+    if (pend >= 0) flush(pend, yprev);
+    return true;
+}
